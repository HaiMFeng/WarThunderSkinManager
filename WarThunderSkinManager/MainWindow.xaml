<Window x:Class="WarThunderSkinManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels"
        xmlns:views="clr-namespace:WarThunderSkinManager.Views"
        Title="{loc:Loc app.title}"
        Icon="Assets/app.ico"
        Height="720" Width="1120"
        MinWidth="900" MinHeight="560"
        Opacity="0"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}"
        WindowStyle="None"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（拖动阈值后才进 DragMove，保证双击切换最大化可用）；底部分隔线与导航栏顶线相连 -->
            <Border Grid.Row="0" Background="{StaticResource BrushBackground}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="14,0"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                <!-- 全局状态提示：统一放在应用名右侧（所有页面的操作反馈都来这里）；
                     连续相同消息不重新赋值，改由 StatusFlash 驱动一次主色光晕脉冲（见 MainWindow.xaml.cs） -->
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Style="{StaticResource TitleBarStatusText}" Text="{Binding StatusMessage}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <!-- 最大化 ⇄ 还原：图标随窗口状态切换 -->
                    <Button Click="Maximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            </Border>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航（顶部分隔线由标题栏底线贯通提供） -->
                <Border Grid.Column="0" Background="{StaticResource BrushCanvas}"
                        BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushBorder}">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc nav.header}" Margin="22,0,0,8" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Skins}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.skins}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Vehicles}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.vehicles}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 多源复用（§3.13）：仅在设置开启后可见 -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.PartReuse}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PartReuseVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.PartReuse}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.partReuse}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Settings}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右侧内容 -->
                <Border Grid.Column="1" Background="{StaticResource BrushBackground}">
                    <Grid Margin="28">
                        <views:SkinManagementView>
                            <views:SkinManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SkinManagementView.Style>
                        </views:SkinManagementView>

                        <views:VehicleManagementView>
                            <views:VehicleManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VehicleManagementView.Style>
                        </views:VehicleManagementView>

                        <views:PartsView>
                            <views:PartsView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.PartReuse}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PartsView.Style>
                        </views:PartsView>

                        <views:SettingsView>
                            <views:SettingsView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsView.Style>
                        </views:SettingsView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 拖入导入提示（把涂装文件夹 / 压缩包拖到窗口任意位置，§3.1） -->
            <Border x:Name="DropHint" Grid.Row="0" Grid.RowSpan="2" Margin="10"
                    Background="{StaticResource BrushBackground}" Opacity="0.94"
                    BorderBrush="{StaticResource BrushPrimary}" BorderThickness="2" CornerRadius="12"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="34"
                               Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc import.drop.hint}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
