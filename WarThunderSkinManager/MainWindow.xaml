<Window x:Class="WarThunderSkinManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels"
        xmlns:views="clr-namespace:WarThunderSkinManager.Views"
        Title="{loc:Loc app.title}"
        Icon="Assets/app.ico"
        Height="720" Width="1120"
        MinWidth="900" MinHeight="560"
        FontFamily="symbols_skyquake, Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}"
        WindowStyle="None"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        SizeChanged="OnWindowSizeChanged"
        Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- 启动淡入（§6）：**动画内部根容器，而不是窗口本身**。
         窗口级 Opacity<1 需要把 HWND 变成分层窗口，而分层样式要到动画首次赋值才生效 ——
         首帧窗口仍以"未分层"的实色整窗背景绘制一下，随后才被置为透明再淡入，表现为启动
         瞬间"一层灰色遮罩闪一下"（自初版就存在）。改为动 RootBorder 后窗口自身始终不透明，
         分层窗口与首帧闪烁一并消失；淡入观感（300ms）不变。 -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" Opacity="0"
            BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（拖动阈值后才进 DragMove，保证双击切换最大化可用）；底部分隔线与导航栏顶线相连 -->
            <Border Grid.Row="0" Background="{StaticResource BrushBackground}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <!-- Background=Transparent：让整个标题栏区域参与命中测试（空白处不补会点击穿透，只有文字那块能拖） -->
            <Grid Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="14,0"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <!-- 置顶：点一下置顶、再点一下取消（图钉 &#xF08D;；置顶时图标变主色以示状态） -->
                    <Button Content="&#xF08D;" Click="Pin_Click" ToolTip="{loc:Loc app.window.pin}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 三个窗口按钮：字形统一取自图标字体 Font Awesome 7 Free Solid
                         （关闭键的字形写在 TitleBarCloseButton 样式里，调用方无需给 Content） -->
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xF2D1;" Click="Minimize_Click"/>
                    <!-- 最大化 ⇄ 还原：字形随窗口状态切换 -->
                    <Button Content="&#xF2D0;" Click="Maximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xF2D2;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            </Border>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 导航列 **Auto**：宽度由 NavPane 自己持有（要动画的就是它这一个值）。
                         展开 220 / 折叠 64 的令牌见界面设计规范 §2.3 / §5.13 -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航（顶部分隔线由标题栏底线贯通提供）。
                     折叠态 = 只显示图标：**不切标签的 Visibility，而是让 64 宽的窗格把它裁掉**
                     （NavButton 模板开了 ClipToBounds）→ 宽度动画与"标签滑出"是同一个动作，
                     不会出现"先跳字、再变宽"。
                     宽度：初值由 NavPaneWidth 绑定给出（WPF 初始帧不执行 EnterActions，
                     所以不能只靠动画）；状态**变化**时才由下面两条 EnterActions 补 200ms 过渡。
                     CubicEase EaseOut 与页面切换同一曲线，见 §6 -->
                <Border x:Name="NavPane" Grid.Column="0" Width="{Binding NavPaneWidth}"
                        Background="{StaticResource BrushCanvas}"
                        BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushBorder}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- To 必须与 MainViewModel.NavCompactWidth（76）一致：
                                                     差值会在动画结束时被 FillBehavior=Stop 一把拽回来；自检会核对这两个数 -->
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="76" Duration="0:0:0.2" FillBehavior="Stop">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNavCompact}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="220" Duration="0:0:0.2" FillBehavior="Stop">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Margin="0,14,0,0">
                        <!-- 「导航」标题 + 折叠按钮同一行：折叠后标题收起，按钮**右对齐位置不动**
                             （两态下都在右上角，点起来手感一致）。 -->
                        <Grid Margin="22,0,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{loc:Loc nav.header}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <!-- 折叠后 64 宽的窗格里放不下这行小标题（也不该被裁成半个字）→ 整块收起 -->
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 折叠 / 展开（仅图标 → **必须**有悬停提示，提示随形态切换）。
                                 窗口太窄时展开没有意义（展开了也还是紧凑态）→ 禁用并说明原因（见 VM） -->
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Command="{Binding ToggleNavCommand}"
                                    IsEnabled="{Binding NavToggleEnabled}"
                                    ToolTip="{Binding NavToggleTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <!-- 字形也走 Setter（不能写在外层 Content 上：本地值优先级高于触发器） -->
                                        <Setter Property="Content" Value="&#xF053;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                                                <Setter Property="Content" Value="&#xF054;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- 导航项：`Tag` = 折叠态下的悬停提示文案（折起来就只剩图标，没有提示就读不出是什么） -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Skins}"
                                Tag="{loc:Loc nav.skins}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF1FC;" FontFamily="{StaticResource IconFont}" FontSize="14" TextAlignment="Center"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.skins}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Vehicles}"
                                Tag="{loc:Loc nav.vehicles}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF072;" FontFamily="{StaticResource IconFont}" FontSize="14" TextAlignment="Center"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.vehicles}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 多源复用（§3.13）：仅在设置开启后可见 -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.PartReuse}"
                                Tag="{loc:Loc nav.partReuse}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PartReuseVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.PartReuse}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF24D;" FontFamily="{StaticResource IconFont}" FontSize="14" TextAlignment="Center"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.partReuse}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.WtLive}"
                                Tag="{loc:Loc nav.wtlive}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.WtLive}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF290;" FontFamily="{StaticResource IconFont}" FontSize="14" TextAlignment="Center"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.wtlive}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Settings}"
                                Tag="{loc:Loc nav.settings}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF013;" FontFamily="{StaticResource IconFont}" FontSize="14" TextAlignment="Center"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右侧内容 -->
                <Border Grid.Column="1" Background="{StaticResource BrushBackground}">
                    <Grid Margin="28">
                        <views:SkinManagementView>
                            <views:SkinManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SkinManagementView.Style>
                        </views:SkinManagementView>

                        <views:VehicleManagementView>
                            <views:VehicleManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VehicleManagementView.Style>
                        </views:VehicleManagementView>

                        <views:PartsView>
                            <views:PartsView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.PartReuse}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:PartsView.Style>
                        </views:PartsView>

                        <views:WtLiveView>
                            <views:WtLiveView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.WtLive}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:WtLiveView.Style>
                        </views:WtLiveView>

                        <views:SettingsView>
                            <views:SettingsView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsView.Style>
                        </views:SettingsView>
                    </Grid>
                </Border>
            </Grid>

            <!-- WT Live 涂装详情浮窗（点浏览页卡片打开，§5.7.1）：图片轮播 + 完整信息 + 下载。
                 只盖内容区（Row=1）——标题栏的窗口按钮保持可用；层级在 BusyOverlay(50) 之下，
                 于是"在详情里点下载 → 确认窗 + 全局处理中遮罩"仍压在最上面。
                 Esc / ← → 由 MainWindow 的键盘闸门转成 VM 命令。 -->
            <views:WtLiveDetailOverlay Grid.Row="1" Panel.ZIndex="40"/>

            <!-- 「收藏的作者」浮窗（WtLive 页工具栏星标按钮打开）：头像 / 昵称 / 取消收藏，
                 拖动排序，点一行按作者搜索。同样只盖内容区；层级压在详情浮窗之上（两者本不会同时开，
                 这里只是给个确定的次序）。Esc 由 MainWindow 的键盘闸门转成 CloseCommand。 -->
            <views:WtLiveFavoritesOverlay Grid.Row="1" Panel.ZIndex="41"/>

            <!-- 拖入导入提示（把涂装文件夹 / 压缩包拖到窗口任意位置，§3.1） -->
            <Border x:Name="DropHint" Grid.Row="0" Grid.RowSpan="2" Margin="10"
                    Background="{StaticResource BrushBackground}" Opacity="0.94"
                    BorderBrush="{StaticResource BrushPrimary}" BorderThickness="2" CornerRadius="12"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xF56F;" FontFamily="{StaticResource IconFont}" FontSize="30"
                               Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc import.drop.hint}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 全局"处理中"遮罩（§2.6）：样式统一、可复用，实现见 Views/BusyOverlay.xaml。
                 文案 / 进度 / 取消由 BusyIndicator 驱动（嵌套时取最外层）。 -->
            <views:BusyOverlay Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50"/>

            <!-- 顶部居中的气泡提示（§2.7，替代原先标题栏那一行状态文本）：
                 最多 4 条纵向堆叠、每条 3 秒、底部剩余时间进度条、点击消除 —— 规则都在 ToastService 里。
                 层级 60 > 遮罩 50：连"处理中"期间的操作结果（如导入完成）也要看得见；
                 顶部偏移 44 = 标题栏 36 + 8 间隙，不遮标题栏上的窗口按钮。
                 只占自身内容尺寸，空白处不参与命中测试（见 StatusToastsView）。 -->
            <views:StatusToastsView Grid.RowSpan="2" Panel.ZIndex="60"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Margin="0,44,0,0"/>
            </Grid>
    </Border>
