<Window x:Class="WarThunderSkinManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels"
        xmlns:views="clr-namespace:WarThunderSkinManager.Views"
        Title="{loc:Loc app.title}"
        Height="720" Width="1120"
        MinWidth="900" MinHeight="560"
        Opacity="0"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="{StaticResource BrushBackground}"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBackground}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="14,0"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{StaticResource BrushCanvas}"
                        BorderThickness="0,1,1,0" BorderBrush="{StaticResource BrushBorder}">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc nav.header}" Margin="22,0,0,8" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}"/>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Skins}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.skins}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Vehicles}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.vehicles}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:TabKey.Settings}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右侧内容 -->
                <Border Grid.Column="1" Background="{StaticResource BrushBackground}">
                    <Grid Margin="28">
                        <views:SkinManagementView>
                            <views:SkinManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Skins}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SkinManagementView.Style>
                        </views:SkinManagementView>

                        <views:VehicleManagementView>
                            <views:VehicleManagementView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Vehicles}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VehicleManagementView.Style>
                        </views:VehicleManagementView>

                        <views:SettingsView>
                            <views:SettingsView.Style>
                                <Style TargetType="UserControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Static vm:TabKey.Settings}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsView.Style>
                        </views:SettingsView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
