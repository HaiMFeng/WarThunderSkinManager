<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- 版本与作者的**单一来源**：设置页「关于」经程序集特性读取（编译进 exe，外部不可改）。
             发布新构建只需改这里（Version 生成 InformationalVersion，界面显示时加 v 前缀）。 -->
        <Version>0.1.3-dev</Version>
        <Authors>HaiMFeng</Authors>
        <!-- exe / 窗口图标（多尺寸 ico，16–256） -->
        <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="SharpCompress" Version="0.50.4" />
    </ItemGroup>

    <ItemGroup>
      <!-- 内置载具译名表：内部标识 → 各语言译名（见 docs/软件功能设计.md §3.7） -->
      <EmbeddedResource Include="Assets\units.csv" />
      <!-- 内置武器名表：判断部件位置是不是武器（见 docs/软件功能设计.md §3.6） -->
      <EmbeddedResource Include="Assets\units_weaponry.csv" />
      <!-- 内置商店归属表（shop.blkx）：载具 id → 国家 / 军种，国家自动归类用（见 docs/shop.blkx 参考.md） -->
      <EmbeddedResource Include="Assets\shop.blkx" />
      <!-- 内置语言文件（zh-CN 默认 / en-US；界面语言切换见 docs/软件功能设计.md §3.9） -->
      <EmbeddedResource Include="Assets\lang\zh-CN.json" />
      <EmbeddedResource Include="Assets\lang\en-US.json" />
      <!-- 品牌资源：窗口图标（多尺寸 ico）与应用内灰轮廓镂空 Logo（经 OpacityMask 按主题染色） -->
      <Resource Include="Assets\app.ico" />
      <Resource Include="Assets\logo-outline.png" />
      <!-- 游戏符号字体（族名 symbols_skyquake，仅 15 个符号字形）：国旗 / 弹药等占位符的渲染源
           （源文件在仓库根目录，Link 引用；窗口字体链的**首位**——特殊字形被它截住渲染成图标，
           正常字符回退到 Segoe UI / 雅黑；未安装的机器由 IconFontLoader 私有注册嵌入副本） -->
      <Resource Include="..\symbols_skyquake.ttf" Link="Assets\symbols_skyquake.ttf" />
    </ItemGroup>

</Project>
