    <Color x:Key="ColorTagWeaponBg">#3f1d24</Color>
    <Color x:Key="ColorTagWeaponBorder">#f87171</Color>
    <Color x:Key="ColorTagWeaponText">#fca5a5</Color>
    <Color x:Key="ColorTagCrossBg">#2a2344</Color>
    <Color x:Key="ColorTagCrossBorder">#8b5cf6</Color>
    <Color x:Key="ColorTagCrossText">#c4b5fd</Color>
    <Color x:Key="ColorActive">#22c55e</Color>
    <Color x:Key="ColorActiveFill">#22c55e</Color>
    <Color x:Key="ColorActiveStrip">#CC14532D</Color>
    <!-- 透明色：悬停离开动画的终点。rgb 随主题走（深色用黑），避免淡出途中闪白 -->
    <Color x:Key="ColorTransparent">#00000000</Color>
</ResourceDictionary>
