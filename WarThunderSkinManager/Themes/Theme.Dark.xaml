<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 主题：深色（石板深蓝；主色提亮保证对比度；危险 / 激活语义色保留） ============ -->
    <Color x:Key="ColorPrimary">#3b82f6</Color>
    <Color x:Key="ColorPrimaryHover">#60a5fa</Color>
    <Color x:Key="ColorPrimaryPressed">#2563eb</Color>
    <Color x:Key="ColorPrimaryFill">#3b82f6</Color>
    <Color x:Key="ColorPrimaryFillHover">#60a5fa</Color>
    <Color x:Key="ColorPrimaryFillPressed">#2563eb</Color>
    <Color x:Key="ColorAccent">#60a5fa</Color>
    <Color x:Key="ColorBorder">#253352</Color>
    <Color x:Key="ColorBorderStrong">#2f4066</Color>
    <Color x:Key="ColorBorderFocus">#3b82f6</Color>
    <Color x:Key="ColorSurface">#16203a</Color>
    <Color x:Key="ColorSurface2">#1c2a4a</Color>
    <Color x:Key="ColorHover">#1a2542</Color>
    <Color x:Key="ColorBackground">#0f172a</Color>
    <Color x:Key="ColorCanvas">#111a2e</Color>
    <Color x:Key="ColorText">#e2e8f0</Color>
    <Color x:Key="ColorTextSecondary">#a8b6cf</Color>
    <Color x:Key="ColorTextMuted">#64748b</Color>
    <Color x:Key="ColorDanger">#f87171</Color>
    <Color x:Key="ColorDangerHover">#ef4444</Color>
    <Color x:Key="ColorDangerPressed">#dc2626</Color>
    <Color x:Key="ColorDangerSoftBg">#3a1d24</Color>
    <Color x:Key="ColorDangerSoftBorder">#7f2f3a</Color>
    <Color x:Key="ColorDangerSoftText">#fca5a5</Color>
    <Color x:Key="ColorWarning">#fbbf24</Color>
    <Color x:Key="ColorOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorCardOverlay">#CC0B1220</Color>
    <Color x:Key="ColorShadow">#000000</Color>
    <Color x:Key="ColorScrollBarTrack">#16203a</Color>
    <Color x:Key="ColorScrollBarThumb">#2f4066</Color>
    <Color x:Key="ColorScrollBarThumbHover">#3d5278</Color>
    <Color x:Key="ColorScrollBarThumbDrag">#5570a0</Color>
    <Color x:Key="ColorTagDefaultBg">#1c2f55</Color>
