<Window x:Class="WarThunderSkinManager.Views.PackageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        Title="{loc:Loc pkg.editor.title}"
        Width="920" Height="680"
        MinWidth="780" MinHeight="500"
        WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{loc:Loc pkg.editor.title}" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="20,18,20,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 只读信息 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="{loc:Loc pkg.editor.vehicle}" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding VehicleId}" Margin="6,0,18,0" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc pkg.editor.partsCount}" Foreground="{StaticResource BrushTextMuted}"/>
                        <TextBlock Text="{Binding PartCount}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc pkg.editor.preview}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>

                    <!-- 预览区（400x400 正方形；图片 Uniform 居中，不裁剪） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="400" Height="400" CornerRadius="8"
                                Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                Margin="0,0,14,0" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock Text="{loc:Loc pkg.editor.noPreview}" Style="{StaticResource PageSubtitle}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Width="150" VerticalAlignment="Top">
                            <Button Content="{loc:Loc pkg.editor.chooseFile}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Command="{Binding ChoosePreviewCommand}"/>
                            <Button Content="{loc:Loc pkg.editor.paste}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding PastePreviewCommand}"/>
                            <Button Content="{loc:Loc pkg.editor.clear}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding ClearPreviewCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 显示名 -->
                    <TextBlock Text="{loc:Loc pkg.editor.name}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                    <TextBox Style="{StaticResource BaseTextBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 资源包开关（§3.5）：只读素材；解锁（开→关）有知会，解锁后可修改部件贴图 -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc pkg.editor.resource}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{loc:Loc pkg.editor.resource.hint}" Style="{StaticResource PageSubtitle}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IsResource}"/>
                    </Grid>

                    <!-- 部件贴图（该包自己的属性，§3.5 / §3.6）；资源包为只读 -->
                    <TextBlock Text="{loc:Loc pkg.editor.parts}" Style="{StaticResource SectionTitle}" Margin="0,24,0,4"/>
                    <TextBlock Text="{loc:Loc pkg.editor.partsHint}"
                               TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEditTextures}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 资源包不可更改横幅（警示色，比普通提示醒目） -->
                    <Border CornerRadius="6" Padding="12,9" Margin="0,0,0,10"
                            Background="{StaticResource BrushDangerSoftBg}"
                            BorderBrush="{StaticResource BrushDangerSoftBorder}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEditTextures}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource BrushDanger}" VerticalAlignment="Top"
                                       Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc pkg.editor.partsHintResource}"
                                       Foreground="{StaticResource BrushDangerSoftText}" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc pkg.editor.col.part}"
                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc pkg.editor.col.mode}"
                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{loc:Loc pkg.editor.col.tex}"
                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Parts}" IsEnabled="{Binding CanEditTextures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <!-- 部件名 + 推测标签（部位 / 贴图类型，按命名规律推断，仅供参考） -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding From}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}"
                                                              VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- 部件标签胶囊：应用级共享模板（ThemeResources.PartTagTemplate），与多源复用 / 载具管理一致 -->
                                                        <StaticResource ResourceKey="PartTagTemplate"/>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <TextBlock Text="{Binding CandidateCountText}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- 写入方式滑块（blk 里写 replace_tex 还是 set_tex）；初值跟随所选贴图 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc pkg.editor.mode.replace}" FontSize="12"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReplaceMode}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="8,0"
                                                      IsChecked="{Binding IsSetMode}"
                                                      IsEnabled="{Binding IsModeEnabled}"/>
                                            <TextBlock Text="{loc:Loc pkg.editor.mode.set}" FontSize="12"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSetMode}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <ComboBox Grid.Column="2" Style="{StaticResource BaseComboBox}"
                                                  MaxDropDownHeight="260"
                                                  ItemsSource="{Binding Candidates}"
                                                  SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- 跨载具复用标注：Gaijin 靠相同的 from 在不同载具间复用贴图（§3.6） -->
                                                        <Border Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                                    <Setter Property="Background" Value="{StaticResource BrushTagCrossBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushTagCrossBorder}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCrossVehicle}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding CrossVehicleText}" FontSize="11"
                                                                       Foreground="{StaticResource BrushTagCrossText}"/>
                                                        </Border>
                                                        <!-- 多源复用标注（§3.13）：组内其他 from 的贴图，红色提醒这是用户自证的复用 -->
                                                        <Border Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                                    <Setter Property="Background" Value="{StaticResource BrushTagWeaponBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushTagWeaponBorder}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMultiSource}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding MultiSourceText}" FontSize="11"
                                                                       Foreground="{StaticResource BrushTagWeaponText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontSize="12" Foreground="{StaticResource BrushDanger}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,18">
                <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="{loc:Loc common.ok}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
