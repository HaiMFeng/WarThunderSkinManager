<UserControl x:Class="WarThunderSkinManager.Views.WtLiveDownloadsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <!-- WT Live 下载列表入口（涂装管理页页头与 WT Live 页工具栏**共用同一个控件**，§3.17）：
         图标 = **`F063`（arrow-down）**——与卡片右下角的下载按钮、列表空态插图**同一个字形**，
         三处"下载"入口在整页里形状一致（原先这里是 `F0ED` cloud-arrow-down 的云朵，笔画密、14px 下发糊，
         与卡片那边的箭头不是一个密度）；
         **悬停展开浮窗、移出关闭**（带 250ms 延时，给鼠标从按钮移入浮窗留出间隙）。
         图标着色反映任务状态：有下载 / 导入任务 = 主题主色（一眼看出在忙），无任务或全部结束 = 次要色。
         抽成控件而不是各页复制一份：两处的浮窗内容 / 重试语义 / 延时关闭节奏必须完全一致，
         复制两份迟早会改一处漏一处。宿主只给 Margin，DataContext 继承外层（同一窗口内是 MainViewModel），
         所以内部照常按 Skins.* 绑定。 -->
    <Grid>
        <!-- 尺寸**不随字形走**：按钮固定 34×34（正方形），图标内容区是 14×14 的正方形（见下方 Grid），
             两侧内边距对称。此前宽度由字形 advance 决定 —— 换成窄字形（`arrow-down` 在 FA 里是 448×512，
             比原先的云朵窄约 5px）后整个按钮跟着缩水，与相邻的「导入…」「在 WT Live 中下载」不再齐平。
             34 与 14 都是**设备无关单位**：WPF 按 DPI 等比缩放，任何缩放比例下都保持正方形、不变形。 -->
        <Button x:Name="ListButton" Width="34" Padding="9,0"
                MouseEnter="ListButton_MouseEnter" MouseLeave="ListButton_MouseLeave">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                    <!-- 无边框变体（WT Live 页工具栏的语言：与相邻的「收藏的作者」图标按钮同一种观感）：
                         透明底 + 无描边 + 高 34 的紧凑尺寸；悬停的浅底反馈沿用次级按钮的触发器。
                         由宿主用 Borderless="True" 打开（涂装管理页页头保持默认的次级按钮外观） -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Borderless, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <!-- 尺寸不在变体里覆盖：宽高由基础的 34×34 统一管住。
                                 去掉 1px 边框后内容区反而宽 2px，图标居中所以看不出差别 -->
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- FontWeight 必须显式 Normal：本按钮的基底样式（ButtonBase）带 `SemiBold`，而图标字体
                 FA Solid **只有一个字重** → 继承 SemiBold 会让 WPF 做"合成加粗"，墨迹沿书写方向向右
                 扩出、边缘发虚；在 34 宽的紧凑变体里看着就像"右侧被切掉一截"。
                 对照：工具栏里相邻的「收藏的作者」用独立样式 IconButton（不继承 ButtonBase），没有这个污染 -->
            <!-- 图标内容区固定成 **14×14 的正方形**（宽高一致），字形在其中**水平 + 垂直居中**：
                 这样按钮宽度就与字形 advance 彻底脱钩 —— 不管换成哪个图标、字体度量怎么变，
                 内容区都是同一个正方形，按钮都是 34×34。
                 （`arrow-down` 这个字形本身是竖长条，放进正方形后两侧自然留白；那是字体设计，不是布局问题。） -->
            <Grid Width="14" Height="14">
                <TextBlock Text="&#xF063;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 三态着色（§3.17）：状态只有**一个来源** —— `Skins.ButtonState`（枚举，天然互斥），
                         优先级**失败 > 下载中 > 默认**由 ViewModel 侧算定（SkinsViewModel.EvaluateButtonState）：
                           ① Failed      → 红色**常亮**（用户主动取消不算失败）
                           ② Downloading → 主题主色 + **呼吸**（Opacity 脉冲渐隐渐显）
                           ③ Idle        → 次要色（走基值 Setter）
                         两个 DataTrigger 的 Value 互斥，所以任意时刻只会命中一个；
                         退出 Downloading 时 ExitActions 移除呼吸动画（Opacity 回落到 1，不会卡在半透明） -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Skins.ButtonState}" Value="Downloading">
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    <DataTrigger.EnterActions>
                                        <!-- 呼吸：1.5 秒一个来回（0.75 正 + 0.75 反），Forever 循环 -->
                                        <BeginStoryboard x:Name="DownloadBreath">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.3"
                                                                 Duration="0:0:0.75"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="DownloadBreath"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Skins.ButtonState}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <!-- VerticalOffset：与按钮之间留出间距（贴太紧像按钮的一部分）；
             横向偏移在代码里按"浮窗右缘对齐按钮右缘"动态设置（见 OpenPopup） -->
        <Popup x:Name="ListPopup" PlacementTarget="{Binding ElementName=ListButton}"
               Placement="Bottom" VerticalOffset="8" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" Width="360"
               MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
            <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc wtlive.list.title}" Style="{StaticResource FieldLabel}"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Skins.WtLiveDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- 文件名可压缩（`*`）：状态文案一长**先压它** ——
                                                 右侧两个操作按钮是最后才该被牺牲的东西 -->
                                            <ColumnDefinition Width="*" MinWidth="72"/>
                                            <!-- 状态文案**限宽**（`Auto` + `MaxWidth`）：它的失败原因直接来自
                                                 异常消息、可能极长；不限宽时 `Auto` 列会按期望宽度撑开，
                                                 把右边两个按钮顶出浮窗（实测踩过） -->
                                            <ColumnDefinition Width="Auto" MaxWidth="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"/>
                                        <!-- 限宽后必然出现截断 → 悬停给全文，信息不丢 -->
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StateText}"
                                                   Style="{StaticResource PageSubtitle}" Margin="12,0,0,0"/>
                                        <!-- 常驻「重试」（**图标按钮** &#xF021;，紧凑、不占文字宽度）：下载中也能点 =
                                             掐断当前下载并重跑（察觉卡死时直接掐断）。
                                             导入中 / 已完成后没有可重试的下载 → 隐藏（避免重复导入同一份压缩包）。
                                             仅图标 → 必须带 ToolTip（说明自动重试节奏与停滞超时） -->
                                        <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Content="&#xF021;"
                                                ToolTip="{loc:Loc wtlive.list.retryHint}"
                                                Command="{Binding DataContext.Skins.RetryWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 取消 / 移除（图标 &#xF00D;，**常驻**，在重试右侧）：
                                             下载中 / 导入中 = **取消**（条目留列表、提示「已取消」、进度清零，可再重试）；
                                             已取消 / 失败 / 已完成 = **从列表移除**（已取消状态再按一次即此语义） -->
                                        <Button Grid.Column="3" Margin="2,0,0,0" VerticalAlignment="Center"
                                                Content="&#xF00D;"
                                                Command="{Binding DataContext.Skins.CancelOrRemoveWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.remove}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelable}" Value="True">
                                                            <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.cancel}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <!-- 进度指示条：下载阶段总进度（压缩包 80% + 预览图 20%）；
                                         ScaleX 绑定 0..1 比例（ProgressBar 最小模板的 PART_Indicator 不会自动变宽） -->
                                    <Grid Height="4" Margin="0,4,0,0">
                                        <Border Background="{StaticResource BrushSurface2}" CornerRadius="2"/>
                                        <Border Background="{StaticResource BrushPrimary}" CornerRadius="2"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc wtlive.downloadlist.empty}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.WtLiveDownloads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
