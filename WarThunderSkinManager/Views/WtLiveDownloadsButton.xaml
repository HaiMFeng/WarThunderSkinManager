<UserControl x:Class="WarThunderSkinManager.Views.WtLiveDownloadsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <!-- WT Live 下载列表入口（涂装管理页页头与 WT Live 页工具栏**共用同一个控件**，§3.15）：
         图标 = 向下箭头 + 底部一横；**悬停展开浮窗、移出关闭**（带 250ms 延时，给鼠标从按钮移入浮窗留出间隙）。
         图标着色反映任务状态：有下载 / 导入任务 = 主题主色（一眼看出在忙），无任务或全部结束 = 次要色。
         抽成控件而不是各页复制一份：两处的浮窗内容 / 重试语义 / 延时关闭节奏必须完全一致，
         复制两份迟早会改一处漏一处。宿主只给 Margin，DataContext 继承外层（同一窗口内是 MainViewModel），
         所以内部照常按 Skins.* 绑定。 -->
    <Grid>
        <Button x:Name="ListButton" Style="{StaticResource SecondaryButton}" Padding="10,6"
                MouseEnter="ListButton_MouseEnter" MouseLeave="ListButton_MouseLeave">
            <TextBlock Text="&#xF0ED;" FontFamily="{StaticResource IconFont}" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Skins.HasActiveDownloads}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <!-- VerticalOffset：与按钮之间留出间距（贴太紧像按钮的一部分）；
             横向偏移在代码里按"浮窗右缘对齐按钮右缘"动态设置（见 OpenPopup） -->
        <Popup x:Name="ListPopup" PlacementTarget="{Binding ElementName=ListButton}"
               Placement="Bottom" VerticalOffset="8" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" Width="360"
               MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
            <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc wtlive.list.title}" Style="{StaticResource FieldLabel}"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Skins.WtLiveDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                   Style="{StaticResource PageSubtitle}" Margin="12,0,0,0"/>
                                        <!-- 常驻「重试」（**图标按钮** &#xF021;，紧凑、不占文字宽度）：下载中也能点 =
                                             掐断当前下载并重跑（察觉卡死时直接掐断）。
                                             导入中 / 已完成后没有可重试的下载 → 隐藏（避免重复导入同一份压缩包）。
                                             仅图标 → 必须带 ToolTip（说明自动重试节奏与停滞超时） -->
                                        <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Content="&#xF021;"
                                                ToolTip="{loc:Loc wtlive.list.retryHint}"
                                                Command="{Binding DataContext.Skins.RetryWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 取消 / 移除（图标 &#xF00D;，**常驻**，在重试右侧）：
                                             下载中 / 导入中 = **取消**（条目留列表、提示「已取消」、进度清零，可再重试）；
                                             已取消 / 失败 / 已完成 = **从列表移除**（已取消状态再按一次即此语义） -->
                                        <Button Grid.Column="3" Margin="2,0,0,0" VerticalAlignment="Center"
                                                Content="&#xF00D;"
                                                Command="{Binding DataContext.Skins.CancelOrRemoveWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.remove}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelable}" Value="True">
                                                            <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.cancel}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <!-- 进度指示条：下载阶段总进度（压缩包 80% + 预览图 20%）；
                                         ScaleX 绑定 0..1 比例（ProgressBar 最小模板的 PART_Indicator 不会自动变宽） -->
                                    <Grid Height="4" Margin="0,4,0,0">
                                        <Border Background="{StaticResource BrushSurface2}" CornerRadius="2"/>
                                        <Border Background="{StaticResource BrushPrimary}" CornerRadius="2"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc wtlive.list.empty}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.WtLiveDownloads.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
