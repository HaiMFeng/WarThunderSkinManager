<Window x:Class="WarThunderSkinManager.Views.AddSubVehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels"
        ShowInTaskbar="False"
        Width="520" Height="470"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="symbols_skyquake, Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="1" Margin="20,16,20,0" TextWrapping="Wrap"
                       FontSize="12" LineHeight="19" Foreground="{StaticResource BrushTextSecondary}"/>

            <TextBox x:Name="SearchInput" Grid.Row="2" Margin="20,12,20,0"
                     Style="{StaticResource BaseTextBox}" FontSize="13"
                     TextChanged="SearchInput_TextChanged"
                     PreviewKeyDown="SearchInput_PreviewKeyDown"/>

            <ListBox x:Name="CandidateList" Grid.Row="3" Margin="20,10,20,0"
                     Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}"
                     BorderThickness="1" Foreground="{StaticResource BrushText}"
                     MouseDoubleClick="CandidateList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SubVehicleItem}">
                        <TextBlock Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Grid.Row="3" Margin="0,10,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="20,8,20,0" TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource BrushDanger}" Visibility="Collapsed"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,18">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
