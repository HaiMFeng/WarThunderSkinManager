<UserControl x:Class="WarThunderSkinManager.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <!-- 可见性由 BusyIndicator 的引用计数驱动（见 BusyOverlay.xaml.cs），
         全局唯一实例 → 不可能同时叠加两个遮罩 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- 压暗底：沿用主题背景色（四套主题自动一致），只压不填实、保留页面轮廓；
             它同时**挡住交互** —— 这是遮罩的一半价值：从根上杜绝重复触发（§2.6） -->
        <Border Background="{StaticResource BrushBackground}" Opacity="0.72"/>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="22,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource BusySpinner}"/>
                    <TextBlock Text="{Binding Text}" Margin="12,0,0,0" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 进度区：无总量（BarVisible=false）时整块折叠，
                     此时观感与旧的"只有加载圈 + 文案"完全一致 -->
                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BarVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Value 必须显式 OneWay：ProgressBar.Value 的默认绑定模式是双向，
                         而 BusyIndicator.Progress 是只读属性（只有 getter）→ 不写 Mode 会在运行期
                         抛「无法对只读属性进行 TwoWay 绑定」。这类错误自检抓不到（自检不建 UI） -->
                    <ProgressBar Width="220" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                 HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <!-- 取消入口：只有传了取消回调才出现（CanCancel）。
                     长任务必须在**遮罩上**就能取消 —— 否则遮罩会挡住别处的取消按钮（实测踩过，
                     见 docs/处理中反馈统一设计.md §3.6） -->
                <Button Content="{loc:Loc common.cancel}" HorizontalAlignment="Right"
                        Margin="0,12,0,0" Click="Cancel_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
