<UserControl x:Class="WarThunderSkinManager.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             Focusable="True" FocusVisualStyle="{x:Null}"
             KeyboardNavigation.TabNavigation="Cycle">
    <!-- 可见性由 BusyIndicator 的引用计数驱动（见 BusyOverlay.xaml.cs），
         全局唯一实例 → 不可能同时叠加两个遮罩 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- 压暗底：沿用主题背景色（四套主题自动一致），只压不填实、保留页面轮廓；
             它同时**挡住交互** —— 这是遮罩的一半价值：从根上杜绝重复触发（§2.6） -->
        <Border Background="{StaticResource BrushBackground}" Opacity="0.72"/>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="22,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- 标题行：加载圈 + 文案。卡片宽度自适应内容，
                     各段都限宽 260（约"进度条 + 计数"的宽度），长条目靠截断/换行而不是撑宽卡片 -->
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource BusySpinner}"/>
                    <TextBlock Text="{Binding Text}" Margin="12,0,0,0" FontSize="13"
                               VerticalAlignment="Center" MaxWidth="230" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 副文案：正在处理的具体条目（如"正在解构 xxx.zip"）。
                     为空时折叠该行 —— 否则卡片会多出一条空行 -->
                <TextBlock Text="{Binding Detail}" Margin="0,8,0,0" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}"
                           MaxWidth="260" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 进度区：无总量（BarVisible=false）时整块折叠，
                     此时观感与"只有加载圈 + 文案"完全一致 -->
                <Grid Width="260" Margin="0,10,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BarVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Value 必须显式 OneWay：ProgressBar.Value 的默认绑定模式是双向，
                         而 BusyIndicator.Progress 是只读属性（只有 getter）→ 不写 Mode 会在运行期
                         抛「无法对只读属性进行 TwoWay 绑定」。这类错误自检抓不到（自检不建 UI） -->
                    <ProgressBar Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Maximum="1" Value="{Binding Progress, Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"/>
                </Grid>

                <!-- 取消入口：只有传了取消回调才出现（CanCancel）。
                     长任务必须在**遮罩上**就能取消 —— 否则遮罩会挡住别处的取消按钮（实测踩过，
                     见 docs/界面设计规范.md §2.6）。
                     请求已投递（CancelRequested）→ 换成「正在取消…」并置灰，等流程自己收尾 -->
                <Button HorizontalAlignment="Right" Margin="0,12,0,0" Click="Cancel_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Content" Value="{loc:Loc common.cancel}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CancelRequested}" Value="True">
                                    <Setter Property="Content" Value="{loc:Loc common.canceling}"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
