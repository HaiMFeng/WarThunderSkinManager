<UserControl x:Class="WarThunderSkinManager.Views.VehicleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 + 操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc vehicles.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc vehicles.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{loc:Loc vehicles.mappings.export}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding Vehicles.ExportMappingsCommand}"/>
                <Button Content="{loc:Loc vehicles.mappings.import}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Vehicles.ImportMappingsCommand}"/>
                <Button Content="{loc:Loc vehicles.mappings.merge}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Vehicles.MergeMappingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 主体：左侧载具列表 + 右侧详情 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 载具列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Vehicles.VehicleCountText}"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="8,6,0,8"/>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc vehicles.empty.desc}"
                               Margin="8,0,8,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasVehicles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Style="{StaticResource SidebarListBox}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             ItemsSource="{Binding Vehicles.Vehicles}"
                             SelectedItem="{Binding Vehicles.SelectedVehicle, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- 未选择 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Loc vehicles.noSelect}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- 已选择 -->
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- 内部标识 + 涂装包数量 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Vehicles.VehicleIdText}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock Text="{Binding Vehicles.PackageCountText}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding Vehicles.PartCountText}" FontSize="13" Margin="10,0,0,0"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 显示名（自动保存） -->
                                <TextBlock Text="{loc:Loc vehicles.displayName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource BaseTextBox}" MaxWidth="380" HorizontalAlignment="Left"
                                         Text="{Binding Vehicles.EditDisplayName, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 国家（自动保存） -->
                                <TextBlock Text="{loc:Loc vehicles.country}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <ComboBox Style="{StaticResource BaseComboBox}" Width="220" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Vehicles.CountryOptions}"
                                          SelectedItem="{Binding Vehicles.SelectedCountryOption, Mode=TwoWay}">
                                    <!-- 用 ItemTemplate 而非 DisplayMemberPath：自定义模板下前者能正确传到选择区 -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 部件（按 from 聚合，只读展示；贴图适配在涂装管理页，见 §3.5 / §3.10） -->
                                <TextBlock Text="{loc:Loc vehicles.parts}" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
                                <TextBlock Text="{loc:Loc vehicles.parts.hint}" Style="{StaticResource PageSubtitle}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Auto：表头列宽随文案（英文比中文长），避免固定宽度截断 -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc vehicles.col.candidates}"
                                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Vehicles.SelectedVehicle.Parts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding From}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <!-- 只统计有可用贴图的候选；为 0 时显示「无」（贴图缺失，见 §3.2） -->
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TextureCandidateCount}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TextureCandidateCount}" Value="0">
                                                                        <Setter Property="Text" Value="{loc:Loc vehicles.none}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
