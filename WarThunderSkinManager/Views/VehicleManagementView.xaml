<UserControl x:Class="WarThunderSkinManager.Views.VehicleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 + 操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc vehicles.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc vehicles.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{loc:Loc vehicles.mappings.export}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding Vehicles.ExportMappingsCommand}"/>
                <Button Content="{loc:Loc vehicles.mappings.import}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Vehicles.ImportMappingsCommand}"/>
                <Button Content="{loc:Loc vehicles.mappings.merge}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Vehicles.MergeMappingsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 主体：左侧载具列表 + 右侧详情 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 载具列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Vehicles.VehicleCountText}"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="8,6,0,8"/>

                    <!-- 载具搜索：匹配内部标识 / 显示名（§3.10） -->
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
                        <TextBox Style="{StaticResource BaseTextBox}"
                                 Text="{Binding Vehicles.VehicleSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- 占位文案**居中**（输入文字仍左对齐——两者是各自独立的元素）；
                             左右对称留白，居中点即框中心；过长时省略号收尾 -->
                        <TextBlock Text="{loc:Loc vehicles.search}" Margin="8,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushTextMuted}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vehicles.VehicleSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc vehicles.empty.desc}"
                               Margin="8,0,8,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasVehicles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Style="{StaticResource SidebarListBox}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             ItemsSource="{Binding Vehicles.Vehicles}"
                             SelectedItem="{Binding Vehicles.SelectedVehicle, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- 未选择 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xF072;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Loc vehicles.noSelect}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- 已选择 -->
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vehicles.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- 内部标识 + 涂装包数量 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Vehicles.VehicleIdText}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock Text="{Binding Vehicles.PackageCountText}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding Vehicles.PartCountText}" FontSize="13" Margin="10,0,0,0"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <!-- 显示名（自动保存） -->
                                <TextBlock Text="{loc:Loc vehicles.displayName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource BaseTextBox}" MaxWidth="380" HorizontalAlignment="Left"
                                         Text="{Binding Vehicles.EditDisplayName, UpdateSourceTrigger=LostFocus}"/>

                                <!-- 国家（自动保存） -->
                                <TextBlock Text="{loc:Loc vehicles.country}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <ComboBox Style="{StaticResource BaseComboBox}" Width="220" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Vehicles.CountryOptions}"
                                          SelectedItem="{Binding Vehicles.SelectedCountryOption, Mode=TwoWay}">
                                    <!-- 用 ItemTemplate 而非 DisplayMemberPath：自定义模板下前者能正确传到选择区 -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <!-- 部件（按 from 聚合，只读展示；贴图适配在涂装管理页，见 §3.5 / §3.10） -->
                                <TextBlock Text="{loc:Loc vehicles.parts}" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
                                <TextBlock Text="{loc:Loc vehicles.parts.hint}" Style="{StaticResource PageSubtitle}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Auto：表头列宽随文案（英文比中文长），避免固定宽度截断 -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc vehicles.col.candidates}"
                                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>

                            <!-- 部件列表：ListBox 自带 VirtualizingStackPanel，只渲染可见行 -->
                            <ListBox Grid.Row="2"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ItemsSource="{Binding Vehicles.SelectedVehicle.Parts}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- 部件名只显示末段（去掉可能写死的作者机器路径）；悬停看原文。
                                                                 已排除的部件（§3.10）**留在列表里**、字体转灰 -->
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" ToolTip="{Binding From}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- 部件标签胶囊：应用级共享模板 PartTagTemplate（§3.6） -->
                                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                                          ItemTemplate="{StaticResource PartTagTemplate}"
                                                                          Margin="6,0,0,0" VerticalAlignment="Center" IsTabStop="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- 正常行：只统计有可用贴图的候选，为 0 显示「无」（贴图缺失，见 §3.2）；
                                                             已排除行：显示「已排除」（§3.10） -->
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Foreground="{StaticResource BrushTextMuted}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding TextureCandidateCount}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                            <Setter Property="Text" Value="{loc:Loc vehicles.part.excluded}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsExcluded}" Value="False"/>
                                                                                <Condition Binding="{Binding TextureCandidateCount}" Value="0"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Text" Value="{loc:Loc vehicles.none}"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 删除 / 恢复（§3.10）：同一个按钮随行的排除态切换——
                                                             正常行 = 「删除」（次要样式）；已排除行 = 「恢复」（红字 + 红描边） -->
                                                        <Button Margin="12,0,0,0"
                                                                Command="{Binding DataContext.Vehicles.DeleteOrRestorePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Setter Property="Content" Value="{loc:Loc vehicles.part.delete}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                            <Setter Property="Content" Value="{loc:Loc vehicles.part.restore}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        </ListBox>

                                        </Grid>
                                        </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
