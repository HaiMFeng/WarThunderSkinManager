<UserControl x:Class="WarThunderSkinManager.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc about.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc about.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

            <!-- 关于（自设置页右侧那一列迁来，改成页面里的卡片）：Logo + 使用声明 +
                 作者 / 版本 / 构建 + 项目与发布页链接 + 桌面快捷方式（两态按钮见
                 docs/应用自更新设计.md §7.4） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.about}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <!-- 大尺寸镂空 Logo：OpacityMask 以主题色染色（灰轮廓图随亮暗主题适配） -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Rectangle Fill="{StaticResource BrushTextSecondary}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Assets/logo-outline.png" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>

                    <!-- 使用声明（一句话版；完整声明见项目 README） -->
                    <TextBlock Text="{loc:Loc settings.about.disclaimer}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc settings.about.author}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0">
                            <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AuthorUrl}"
                                       Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                                <Run Text="{Binding AboutAuthor, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc settings.about.version}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                   ToolTip="{loc:Loc settings.about.versionTip}">
                            <Hyperlink Command="{Binding CopyVersionCommand}"
                                       Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                                <Run Text="{Binding AboutVersion, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- 构建短哈希：同一版本号可能对应多个构建（改了代码但没改版本号）——
                         没有这一行就没法确认"装的是哪次构建"（实测踩过：装的是修 bug 之前的构建却看不出来）。
                         没有哈希时（某些本地构建）整行隐藏 -->
                    <TextBlock Text="{Binding AboutBuildText}" Margin="0,4,0,0" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AboutBuildText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{loc:Loc settings.about.openProject}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding ProjectUrl}"/>
                        <Button Content="{loc:Loc settings.about.releases}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding ReleasesUrl}"/>
                    </StackPanel>

                    <!-- 桌面快捷方式（§7.4）：两态按钮（与安装器共用同一个固定名字，幂等）。
                         便携运行时也能用（指向当前 exe）——这是它存在的主要理由 -->
                    <Button Content="{Binding DesktopShortcutActionText}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding ToggleDesktopShortcutCommand}"/>
                </StackPanel>
            </Border>

            <!-- 更新应用（§3.16）：安装器渠道 + 应用内自更新；规格见 docs/应用自更新设计.md。
                 这是本页的第二张卡（**程序版本**）；数据表的「更新资源」仍留在设置页，
                 两张卡措辞要能区分"程序"与"数据表" -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.appUpdate}" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.appUpdate.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- 状态行 -->
                    <TextBlock Text="{Binding AppUpdateText}" TextWrapping="Wrap"/>

                    <!-- 新版本详情（版本 / 日期 / 体积 + 说明要点，纯文本） -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdateHasDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding AppUpdateVersionText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding AppUpdateNotesText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>

                    <!-- 下载进度 -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdateIsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding AppUpdateProgress}"/>
                        <TextBlock Text="{Binding AppUpdateProgressText}" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>

                    <!-- 操作区：主操作随状态切换（更新 / 取消 / 立即重启并安装 / 检查更新）。
                         注意：给了 <Button.Style> 子元素就不能再写 Style= 属性（重复赋值会编译失败） -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc settings.appUpdate.update}"
                                Command="{Binding RunAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.cancel}"
                                Command="{Binding CancelAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateIsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.installNow}"
                                Command="{Binding InstallAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanInstall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.check}"
                                Command="{Binding CheckAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanCheck}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 次操作：跳过此版本 / 撤销跳过 / 查看完整说明 -->
                        <Button Content="{loc:Loc settings.appUpdate.skip}" Margin="8,0,0,0"
                                Command="{Binding SkipAppUpdateVersionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.unskip}" Margin="8,0,0,0"
                                Command="{Binding UnskipAppUpdateVersionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUnskip}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.notes}" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding AppUpdateReleaseUrl}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateHasDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 手动下载 / 旧版本：一律可达（网络不通、校验失败、便携运行时的兜底出口） -->
                        <Button Content="{loc:Loc settings.appUpdate.manual}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesUrl}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
