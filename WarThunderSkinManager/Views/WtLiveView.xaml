<UserControl x:Class="WarThunderSkinManager.Views.WtLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             xmlns:ctrl="clr-namespace:WarThunderSkinManager.Controls"
             xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels">
    <!-- WT Live 涂装浏览：瀑布流（等宽卡片 / 高度随图片比例 / 最短列优先，见 Controls/MasonryPanel.cs）
         + 滚动到底自动加载下一页。接口依据见 docs/WTLive_涂装_API.md。 -->
    <!-- 缩略图框的高度不再由模板自己算（那要靠 RelativeSource 找祖先面板拿列宽，容器回收复用时
         可能踩空 → 框塌成 0 高）。改由面板算好推给数据项（WtLiveCardItem.ImageHeight），模板只平绑定它。
         公式仍在 Controls/AspectRatioHeightConverter.ImageHeight：面板与卡片内边距共用同一个数 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 = 上方的**工具栏**，本身分左右两列：
             左列两行 —— ① 标题；② 搜索提示（默认「所有涂装」，有筛选时写成人话）。
             右列 —— 排序 / 搜索 / 刷新这些工具，**向下对齐**：底边与页头底边齐平，
             于是整排按钮正好停在下面的瀑布流上方。
             页头高度是**定值**：提示始终占位（不再收起），右列又固定成两行搜索框那么高（60）——
             胶囊再多也撑不高页头，只在搜索框内部滚动。 -->
        <Grid x:Name="Header" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：标题 + 搜索提示，两行 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 标题 -->
                    <RowDefinition Height="Auto"/>   <!-- 搜索提示 -->
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeaderTitle" Grid.Row="0" HorizontalAlignment="Left"
                           Text="{loc:Loc wtlive.page.title}" Style="{StaticResource PageTitle}"/>

                <!-- 搜索提示——胶囊在界面上是一块块，这行把它写成人话，也点明走的是哪条通道
                     （按载具 / 按标签）；没有筛选时就是默认的「所有涂装」。
                     要点：① 单行 + 省略号，标签再多也不换行；
                          ② 空态用弱化色、有筛选时转主色 → 一眼能区分"提示"与"当前条件" -->
                <TextBlock x:Name="FilterSummary" Grid.Row="1" Margin="0,4,0,0"
                           HorizontalAlignment="Left"
                           MaxWidth="420" FontSize="12"
                           Text="{Binding WtLive.ActiveFilterText}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WtLive.HasFilter}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 右列：排序 + 搜索 + 刷新（刷新是**图标按钮**，悬停有 ToolTip）。
                 搜索框**不只用来选载具**：输入即给下拉——载具、标签、清除三条通道；
                 选中的候选不写回输入框，而是变成**胶囊**（载具最多一个、标签可叠多个），
                 退格一次删一个（见 WtLiveViewModel / WtLiveSearchChip）。
                 **MinHeight = 60 = 两行搜索框（34 + 26 × 2）**：这一列的高度因此是**定值**，
                 搜索框长到两行就"占满工具栏"、再多改成框内滚动（见 SearchShell 的 MaxHeight），
                 页头高度不受胶囊多少影响。
                 内部再**向下对齐**（Bottom）：底边贴着页头底边 → 整排工具停在瀑布流上方 -->
            <Grid x:Name="Toolbar" Grid.Column="1" Margin="16,0,0,0" MinHeight="60">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <!-- 排序方式（§5 sort：最近发布 / 热门 / 评论 / 下载）。
                         排在搜索框**左侧**：它是"整份列表怎么排"，先于搜索框这个"要哪些"的入口；
                         选择即从第一页重新拉取（VM 里 OnSelectedSortOptionChanged → Refresh），
                         与搜索 / 刷新共用同一行、同一套 34 高的控件高度。
                         **不给固定宽度**：文案随语言变（中文 4 字 / 英文 Downloads 更长），
                         写死就会在某种语言下过宽或把字裁掉；ComboBox 本身就按最宽项量尺寸，
                         这里让内容自己定，宽度也稳定不跳 -->
                    <ComboBox Margin="0,0,8,0" VerticalAlignment="Center"
                              Style="{StaticResource BaseComboBox}"
                              ToolTip="{loc:Loc wtlive.sort.label}"
                              ItemsSource="{Binding WtLive.SortOptions}"
                              SelectedItem="{Binding WtLive.SelectedSortOption, Mode=TwoWay}">
                        <!-- 用 ItemTemplate 而非 DisplayMemberPath：自定义模板下前者能正确传到选择区 -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 搜索框 = **一个容器**（外壳 Border 是祖先）：
                         [放大镜槽] [胶囊 + 末尾的输入框（同一个 TagInputPanel 流式换行，输入框拉满本行）] [清空槽]。
                         这是 Fluent Tag Picker / MUI Autocomplete / Choices.js 一类成熟控件的做法：
                         ① **外框是容器、输入框是它的后代** —— 悬停 / 聚焦状态才算得上整个框
                            （WPF 的 IsMouseOver / IsKeyboardFocusWithin 都覆盖可视子树，等于 CSS 的 :hover / :focus-within；
                            以前外框是"压在输入框背后的兄弟"，指针移进框中间就会丢掉悬停反馈）；
                         ② 输入框与胶囊**同一个流式容器**，放不下就整体换行
                            （Fluent 原文：tags wrap and will make the height grow to fit the content）；
                         ③ 描边只有外框画一次，输入框自身不带描边，不套框；
                         ④ **长到两行就封顶**（MaxHeight = 60 = 34 + 26 × 2）：再多也不撑高工具栏，
                            改成框内纵向滚动（见下面的 ChipScroll）→ 页头高度恒等于左列「标题 + 提示」 -->
                    <!-- 点框内任意处 = 点进输入框，两半各管一段：
                         ① **布局管中段**：输入框被 TagInputPanel 拉满本行，框里那片空白就是输入框本身，
                            按下由 WPF 原生地落到它身上（自检「搜索框点入」用真实窗口量过命中面）；
                         ② **这层处理器管其余**：两侧放大镜 /「×」槽位（命中元素是外壳自己）、可见的「×」与
                            胶囊「×」（命中元素是按钮，按钮会吃掉冒泡的按下）、胶囊之间的缝、上下 3 的留白。
                            挂 **Preview（隧道）**而不是冒泡的 MouseLeftButtonDown：隧道从根往下走、先经过外壳，
                            子元素截不住。判定见 code-behind（只有滚动条不抢）。 -->
                    <Border x:Name="SearchShell" Width="400" MinHeight="34" MaxHeight="60" CornerRadius="6"
                            SnapsToDevicePixels="True" Background="{StaticResource BrushBackground}"
                            BorderThickness="1" PreviewMouseLeftButtonDown="SearchShell_PreviewMouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                    </Trigger>
                                    <!-- 聚焦优先级更高（鼠标还停在框上也该按聚焦色画）。
                                         IsKeyboardFocusWithin 覆盖整棵子树 = CSS 的 :focus-within，
                                         因此不再需要按名字去盯那个输入框。
                                         **描边粗细恒定 1**：以前聚焦时改成 1.5，整框外层会随聚焦 / 失焦
                                         长高、变宽 1px（点进框里就抖一下），和相邻的排序下拉也对不齐。
                                         "加粗"的观感改由下面那圈内侧描边给 -->
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <!-- 聚焦内圈：贴着外侧描边再画一圈（1+1 = 聚焦时看着像 2px 强调），
                                 **不参与布局**（只是无填充的描边，期望尺寸才 2×2），
                                 所以聚焦 / 失焦时框的尺寸纹丝不动，只换描边颜色 + 多这圈 -->
                            <Border CornerRadius="5" BorderThickness="1" Margin="0"
                                    SnapsToDevicePixels="True"
                                    BorderBrush="{StaticResource BrushBorderFocus}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding IsKeyboardFocusWithin,
                                                                   RelativeSource={RelativeSource AncestorType=Border}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- 前导放大镜：浮在左边那条 28 的槽里（纯装饰，不挡点击）。
                                 **用固定高的格子把字形居中**（Height 22 + 顶边距 5 = 第一行内容的
                                 y 范围 5..27），而不是拿 Margin 去凑字体高度——换字体、换字号都不会再偏 -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Height="22" Margin="9,5,0,0" IsHitTestVisible="False">
                                <TextBlock Text="&#xF002;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </Grid>

                            <!-- 胶囊 + 输入框：**同一个流式面板**（Controls/TagInputPanel），输入框是最后一项 →
                                 光标永远跟在最后一个胶囊后面，放不下就换行、框跟着长高；
                                 且**输入框拉满本行剩余宽度**（WrapPanel 做不到，会留一片点不到的空白）。
                                 ItemsSource 用 CompositeCollection（胶囊集合 + 末尾的输入框），
                                 这样只有**一层**流式面板：换行才连续（把输入框放在 ItemsControl 外，
                                 它会被当成一个整块、永远独占一行）。
                                 社区同款坑：① 不能再设 ItemTemplate —— 它会连输入框一起套上胶囊模板，
                                 得改成 ItemsControl.Resources 里的**隐式 DataTemplate**（按 DataType 匹配，
                                 末尾那个 TextBox 是 UIElement，会被原样呈现）；
                                 ② 输入框要给 MinWidth，否则没字时会缩成一条线（宽度不再写 MaxWidth：
                                 由面板拉满本行，MinWidth 只作"塞不下就换行"的阈值）。
                                **高度预算**（治"加第一个胶囊就跳一下高"）：这一行恒为 26 高
                                = 22（胶囊高 = 输入框高）+ 上下各 2 外边距（**胶囊与输入框都给 2，对称**）；
                                再各留 3 → 内容 32、外壳 34，与空态**完全一致**；
                                之后每多一个胶囊只要不换行就不再变高，换行才整行 +26 -->
                            <!-- 溢出在这里滚：外壳 MaxHeight 一卡住（两行），它就自动出现那条 10 宽的
                                 扁平滚动条，工具栏不再被撑高。左右 28 / 上下 3 与原来一致，
                                 滚动条落在右侧那条 28 的槽里，不会压到清空「×」 -->
                            <ScrollViewer x:Name="ChipScroll" Margin="28,3,28,3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ChipList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- **不是 WrapPanel**：它会把末尾输入框按内容宽排成一小条，
                                             右侧留出一大片不响应点击的空白（"点不到输入框"）。TagInputPanel
                                             让最后一项（输入框）拉满本行剩余宽度 → 那片空白就是输入框本身。 -->
                                        <ctrl:TagInputPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.Resources>
                                    <!-- 胶囊（只匹配 WtLiveSearchChip）。
                                         竖直外边距**对称**（2 / 2，曾经是只有下边 2+2），行高才与只有输入框时一致——
                                         否则空态 34、加第一个胶囊 38（那 4px 还全在下边，把胶囊顶得"偏上"）。
                                         左右 4 是胶囊之间的间距 -->
                                    <DataTemplate DataType="{x:Type vm:WtLiveSearchChip}">
                                        <Border Background="{StaticResource BrushSurface2}" CornerRadius="10"
                                                Padding="8,2,4,2" Margin="0,2,4,2" SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushPrimary}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="5,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <!-- 删掉这一个胶囊（退格删最后一个是同一条路，见 code-behind）。
                                                     Focusable=False：点它别把键盘焦点从输入框抢走。
                                                     底色透明 + 字色 muted：悬停时 IconButton 提亮字色，
                                                     用默认底色则与胶囊底色同为 Surface2、看不出悬停 -->
                                                <Button Content="&#xF00D;" Margin="2,0,0,0" Focusable="False"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        ToolTip="{loc:Loc common.close}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.WtLive.RemoveChipCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Width" Value="18"/>
                                                            <Setter Property="Height" Value="18"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>

                                <ItemsControl.ItemsSource>
                                    <CompositeCollection>
                                        <!-- CollectionContainer 不在可视树里、继承不到 DataContext，必须显式给 Source。
                                             **踩过的坑**：x:Reference 不能指向「包含这个绑定的元素」（外壳 SearchShell、
                                             甚至 XAML 根 UserControl 都算）—— 那会构成循环依赖，加载时直接
                                             XamlParseException（MarkupExtension.ProvideValue 抛「循环依赖」），
                                             而且只在控件实例化时才炸，编译期看不出来。
                                             所以借用**同级**、同一个 DataContext 的 Popup 当锚点（它声明在本 ItemsControl 之后，
                                             属前向引用，合法）。ElementName 与无 Source 的 Binding 都拿不到 DataContext，
                                             已实测不可用。改这里时别删掉这个 Popup。 -->
                                        <CollectionContainer
                                            Collection="{Binding DataContext.WtLive.Chips,
                                                         Source={x:Reference SearchPopup}}"/>

                                        <!-- 末尾的输入框：高 22 = 胶囊高，两者文字中线才在同一水平线上；
                                             上下也给 2 外边距 → 与胶囊**行高一致**（见上「高度预算」）。
                                             **不给 MaxWidth**：宽度由 TagInputPanel 拉满本行剩余
                                             （MinWidth 只是"塞不下就换行"的阈值），
                                             否则框里右侧的空白既点不到、看着也不像输入框 -->
                                        <TextBox x:Name="SearchBox" Style="{StaticResource BaseTextBox}"
                                                 Height="22" MinWidth="80" Padding="2,0,0,0"
                                                 Margin="0,2,0,2" VerticalAlignment="Top"
                                                 Text="{Binding WtLive.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                                 LostKeyboardFocus="SearchBox_LostKeyboardFocus">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <!-- 只留内容宿主：**描边只由外壳画**
                                                         （BaseTextBox 的模板聚焦时会把内框硬改成 1.5px 蓝色，
                                                          写在 ControlTemplate.Triggers 里，外面压不住） -->
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  VerticalScrollBarVisibility="Hidden"
                                                                  HorizontalScrollBarVisibility="Hidden"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                    </CompositeCollection>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                            </ScrollViewer>

                        <!-- 占位文案（框里空着才显示）：**水平居中**。
                             它与输入文字是两个各自独立的元素，因此提示居中、输入仍左对齐互不影响；
                             左右各 30 是**对称**内缩（避开左侧放大镜与右侧「×」），
                             这样居中点正好落在输入框中心，而不是被单侧留白推偏。
                             判据用 HasSearchInput：有胶囊时（哪怕输入框是空的）也不该再提示"搜索载具 / #标签" -->
                        <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc wtlive.search.placeholder}" Margin="30,0,30,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.HasSearchInput}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 清空（有文字或有胶囊才出现）：一次清掉条件与输入。
                             顶边距 4 → 24 高的按钮中线落在 16，与第一行胶囊 / 输入框同一中轴 -->
                        <Button x:Name="SearchClear" Content="&#xF00D;"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0" ToolTip="{loc:Loc wtlive.search.clear}"
                                Command="{Binding WtLive.ClearSearchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.HasSearchInput}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 搜索下拉。StaysOpen=True + 手动开合：项是**不可聚焦**的按钮，
                             点它不会让输入框失焦，因此不会出现"点不下去"（见 code-behind 的失焦处理）。
                             **锚点是外壳（SearchShell）而不是那个输入框**：输入框是流式容器的最后一项，
                             胶囊一多、一换行它就往后 / 往下跑 —— 挂在它身上，下拉就会"跟着光标位置"飘。
                             钉在外壳上则恒定**左上角对齐地贴在整个搜索框下方**。
                             （不用 x:Reference / ElementName 指外壳：那会构成循环依赖，
                              见上面 CompositeCollection 的说明；RelativeSource 是**运行时**解析，没这个问题。
                              外壳是这里唯一的 Border 祖先 —— 聚焦内圈那圈 Border 是它的**兄弟**，不是祖先。） -->
                        <Popup x:Name="SearchPopup"
                               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Border}}"
                               Placement="Bottom" VerticalOffset="4"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding WtLive.IsSuggestionsOpen}">
                            <!-- 与主题 ComboBox 下拉同一套外观（底 + 描边 + 圆角 8 + 投影）。
                                 宽度跟搜索框**一样**（400）→ 左边缘对齐后整个下拉正好压在外壳下面 -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Width="400"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                      Opacity="0.14" Color="{StaticResource ColorShadow}"/>
                                </Border.Effect>

                                <ItemsControl ItemsSource="{Binding WtLive.Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Focusable="False" HorizontalContentAlignment="Stretch"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.WtLive.ApplySuggestionCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" CornerRadius="6"
                                                                            Background="{TemplateBinding Background}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <!-- 鼠标悬停与键盘高亮用同一个底色 -->
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background"
                                                                                    Value="{StaticResource BrushSurface}"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                            <Setter TargetName="bd" Property="Background"
                                                                                    Value="{StaticResource BrushSurface}"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" Width="20" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>

                    <!-- 收藏的作者（搜索框右侧、刷新左侧）：点开遮罩浮窗，见 WtLiveFavoritesOverlay -->
                    <Button Content="&#xF005;" Style="{StaticResource IconButton}" Width="34" Height="34"
                            FontSize="14" Margin="8,0,0,0" ToolTip="{loc:Loc wtlive.favorites.open}"
                            Command="{Binding WtLive.Favorites.OpenCommand}"/>

                    <Button Content="&#xF021;" Style="{StaticResource IconButton}" Width="34" Height="34"
                            FontSize="14" Margin="8,0,0,0" ToolTip="{loc:Loc wtlive.refresh}"
                            Command="{Binding WtLive.RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <!-- **像素滚动**（不设 CanContentScroll，保持默认 False）：滚动条长度、滚轮步长、以及页里的
                 "接近底部预取下一页"（ListScroll_ScrollChanged）都按像素走，与改造前完全一致。
                 虚拟化面板**不实现 IScrollInfo**（列表外套 StackPanel —— 页脚要跟着内容滚 —— 面板又随
                 ItemsControl 模板后生成，ScrollViewer 不会把它认成滚动实现），而是自己从祖先 ScrollViewer
                 读 VerticalOffset / ViewportHeight 决定实体化窗口，子项按绝对位置排列，位移仍由这里施加。
                 **不能设成 True**：那会让 VerticalOffset / ViewportHeight 变成"逻辑项数"而非像素，
                 面板按像素算窗口就会永远钉在第 0 项那几张（实测只有 4 张且不随滚动移动）。 -->
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ListScroll_ScrollChanged"
                          PreviewMouseDown="ListScroll_PreviewMouseDown">
                <StackPanel>
                    <!-- VirtualizationMode=Recycling：滚出视口的卡片容器**回收复用**（面板自己在窗口外
                         调 Recycle）—— 首次实例化一张卡片模板约 4 ms，复用只换 DataContext，
                         不做这一步，快速滚动时每滚一屏就是十几处 4 ms 的卡顿 -->
                    <!-- 上方留 4：第一排不贴着区域顶边（悬停的上浮已去掉，这点余量留着当缩进） -->
                    <ItemsControl x:Name="CardList" Margin="0,4,0,0" ItemsSource="{Binding WtLive.Items}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- **虚拟化**瀑布流：只实体化视口附近的卡片（见 VirtualizingMasonryPanel）。
                                     落位算法与 MasonryPanel 共用，结果一致；ChromeGuess 只做首帧兜底，
                                     之后由第一张实测卡片标定文字块高度 -->
                                <ctrl:VirtualizingMasonryPanel TargetItemWidth="240" MinItemWidth="170"
                                                               MaxItemWidth="360" MaxColumns="5" ItemGap="16"
                                                               ChromeGuess="64"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 卡片：白底 + 1px 描边 + 圆角 12。不用 Card 样式（它带阴影：
                                     瀑布流一屏几十张，逐张阴影的开销不值当，改用描边分层）。
                                     整张卡片可点 → 打开详情浮窗（右下角「下载」按钮自己处理点击，不冒泡到这里）。
                                     悬停：描边转强调色 + 卡内图片轻微放大（见下面 Image 的 ScaleTransform）。
                                     **不再做"整张卡上浮 3px"**：上浮是渲染层的位移，卡片挨着视口顶边时
                                     那 3px 落到视口之外，会被滚动视口裁掉一截（滚到半途尤其明显，
                                     看着像"被上面那张/被工具栏盖住"）。瀑布流是绝对定位，卡片之间只有 16px
                                     间距，上浮也换不来多少层次感，索性只留描边 + 图片放大 -->
                                <Border BorderThickness="1"
                                        CornerRadius="12" Padding="12" SnapsToDevicePixels="True"
                                        Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushBackground}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- 缩略图框：高度 = **面板算好推下来的** ImageHeight（图片可用宽 ÷ 宽高比），
                                             图片未到也先按比例占好位。这里**不再自己去问面板要列宽**：
                                             那要靠 RelativeSource 找祖先面板，容器回收复用时可能踩空 ——
                                             一踩空整块框就塌成 0 高（没有转圈、没有占位图标，只剩文字）。
                                             圆角裁剪在 code-behind 做（ClipToBounds 不认 CornerRadius） -->
                                        <Border x:Name="Thumb" Height="{Binding ImageHeight}"
                                                Background="{StaticResource BrushSurface}" CornerRadius="10"
                                                ClipToBounds="True" SizeChanged="Thumbnail_SizeChanged">
                                            <Grid>
                                                <!-- 加载中：转圈 +（**转够 5s** 才浮现的）「重新加载」。
                                                     **未加载的卡片不给占位图标**——进页面就有几十张图在排队取图（并发 4），
                                                     静态图标会让人以为这些帖子本来就没图 -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                                        <Viewbox.Style>
                                                            <Style TargetType="Viewbox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Viewbox.Style>
                                                        <ContentControl Style="{StaticResource BusySpinner}"/>
                                                    </Viewbox>

                                                    <!-- 5s 还没好（SlowLoadWatcher）→ 给个出口，别让人对着圈干等。
                                                         命令在 WtLive 上（**不是** MainViewModel 上）：少写一层 .WtLive 时
                                                         WPF 只会静默绑定失败——按钮点下去什么都不发生，最难查的一类 bug -->
                                                    <Button Content="{loc:Loc wtlive.reload}"
                                                            Margin="0,8,0,0" HorizontalAlignment="Center"
                                                            MinWidth="72" Height="26" Padding="10,0" FontSize="12"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.WtLive.ReloadThumbnailCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsThumbnailLoading}" Value="True"/>
                                                                            <Condition Binding="{Binding CanReloadThumbnail}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <!-- 无预览图 / 加载失败：占位图标（失败不转圈，否则永远在"加载"） -->
                                                <TextBlock Text="&#xF03E;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="22" Foreground="{StaticResource BrushTextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 图片**铺满框**：框的高度已经按图片比例定好（框宽 ÷ 宽高比 == 图片高），
                                                     UniformToFill 不会裁边；高度不再由图片自己算（那样框会跟着它一起塌） -->
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                    <!-- 悬停：图片在缩略图框里轻微放大。同样是**渲染层**缩放，
                                                         而且贴着 Thumb 的圆角裁剪跑 —— 不会溢出卡片、也不会触发重排。
                                                         触发器挂在图片自己身上：这张帖子没有预览图时就什么都不动 -->
                                                    <Image.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Image.RenderTransform>
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation To="1.05" Duration="0:0:0.18"
                                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation To="1.05" Duration="0:0:0.18"
                                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation To="1" Duration="0:0:0.16"
                                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation To="1" Duration="0:0:0.16"
                                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- 副标题行 + 右下角「下载」：点它直接进「从 WT Live 下载」确认窗口，
                                             帖子链接已填好并自动读取（省掉"复制链接 → 粘贴 → 读取"三步）。
                                             没有站内附件的帖子不给按钮——那条路只会得到一句"没有可下载的文件" -->
                                        <Grid Margin="2,1,2,0">
                                            <!-- 副标题 = 作者名（**超链接**，点它 = 搜这个作者的涂装）+ 体积 · 下载数。
                                                 两者在同一个流式行里：作者名是 Hyperlink，后面那串自己带前导「 · 」。
                                                 点链接不该顺带打开详情 → 见 Card_MouseLeftButtonUp 里的兜底判断 -->
                                            <TextBlock Margin="0,0,26,0"
                                                       Style="{StaticResource PageSubtitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <Hyperlink CommandParameter="{Binding}"
                                                           Command="{Binding DataContext.WtLive.SearchUserByCardCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Foreground="{StaticResource BrushPrimary}"
                                                           ToolTip="{loc:Loc wtlive.detail.searchAuthor}">
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                </Hyperlink>
                                                <Run Text="{Binding MetaSuffix, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Button Content="&#xF019;" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc wtlive.card.download}"
                                                    CommandParameter="{Binding PostUrl}"
                                                    Command="{Binding DataContext.Skins.OpenWtLiveImportCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFile}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 页脚（已有内容时）：加载下一页 / 失败重试 / 已到底，三者互斥 -->
                    <Grid Margin="0,16,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.IsLoading}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ContentControl Style="{StaticResource BusySpinner}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc wtlive.list.loading}" Margin="10,0,0,0"
                                       Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.HasError}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xF06A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WtLive.ErrorMessage}" Margin="8,0,12,0" MaxWidth="420"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushDanger}"/>
                            <Button Content="{loc:Loc wtlive.list.retry}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding WtLive.RetryCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc wtlive.list.end}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.IsExhausted}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 列表还空着时的整屏状态：首次加载 / 首次失败 / 没有结果（互斥） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ContentControl Style="{StaticResource BusySpinner}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc wtlive.list.loading}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.HasError}" Value="True"/>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xF06A;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding WtLive.ErrorMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{StaticResource BrushDanger}"/>
                <Button Content="{loc:Loc wtlive.list.retry}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center" Margin="0,14,0,0" MinWidth="88"
                        Command="{Binding WtLive.RetryCommand}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                    <Condition Binding="{Binding WtLive.IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding WtLive.HasError}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xF0ED;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc wtlive.list.empty}" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc wtlive.list.emptyHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
