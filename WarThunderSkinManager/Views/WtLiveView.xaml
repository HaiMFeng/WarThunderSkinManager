<UserControl x:Class="WarThunderSkinManager.Views.WtLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             xmlns:ctrl="clr-namespace:WarThunderSkinManager.Controls"
             xmlns:vm="clr-namespace:WarThunderSkinManager.ViewModels">
    <!-- WT Live 涂装浏览：瀑布流（等宽卡片 / 高度随图片比例 / 最短列优先，见 Controls/MasonryPanel.cs）
         + 滚动到底自动加载下一页。接口依据见 docs/WTLive_涂装_API.md。 -->
    <UserControl.Resources>
        <!-- 列宽 + 宽高比 → 缩略图占位高度：图片没下载完也先按比例占好位置 -->
        <ctrl:AspectRatioHeightConverter x:Key="AspectRatioHeight"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc wtlive.page.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc wtlive.page.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 排序 + 搜索 + 刷新（刷新是**图标按钮**，悬停有 ToolTip）。
                 搜索框**不只用来选载具**：输入即给下拉——载具、标签、清除三条通道；
                 选中的候选不写回输入框，而是变成**胶囊**（载具最多一个、标签可叠多个），
                 退格一次删一个（见 WtLiveViewModel / WtLiveSearchChip）。 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 排序方式（§5 sort：最近发布 / 热门 / 评论 / 下载）。
                         排在搜索框**左侧**：它是"整份列表怎么排"，先于搜索框这个"要哪些"的入口；
                         选择即从第一页重新拉取（VM 里 OnSelectedSortOptionChanged → Refresh），
                         与搜索 / 刷新共用同一行、同一套 34 高的控件高度。
                         **不给固定宽度**：文案随语言变（中文 4 字 / 英文 Downloads 更长），
                         写死就会在某种语言下过宽或把字裁掉；ComboBox 本身就按最宽项量尺寸，
                         这里让内容自己定，宽度也稳定不跳 -->
                    <ComboBox Margin="0,0,8,0" VerticalAlignment="Center"
                              Style="{StaticResource BaseComboBox}"
                              ToolTip="{loc:Loc wtlive.sort.label}"
                              ItemsSource="{Binding WtLive.SortOptions}"
                              SelectedItem="{Binding WtLive.SelectedSortOption, Mode=TwoWay}">
                        <!-- 用 ItemTemplate 而非 DisplayMemberPath：自定义模板下前者能正确传到选择区 -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 搜索框 = **一个容器**（外壳 Border 是祖先）：
                         [放大镜槽] [胶囊 + 末尾的输入框（同一个 WrapPanel 流式换行）] [清空槽]。
                         这是 Fluent Tag Picker / MUI Autocomplete / Choices.js 一类成熟控件的做法：
                         ① **外框是容器、输入框是它的后代** —— 悬停 / 聚焦状态才算得上整个框
                            （WPF 的 IsMouseOver / IsKeyboardFocusWithin 都覆盖可视子树，等于 CSS 的 :hover / :focus-within；
                            以前外框是"压在输入框背后的兄弟"，指针移进框中间就会丢掉悬停反馈）；
                         ② 输入框与胶囊**同一个流式容器**，放不下就整体换行、框随内容长高
                            （Fluent 原文：tags wrap and will make the height grow to fit the content）；
                         ③ 描边只有外框画一次，输入框自身不带描边，不套框 -->
                    <Border x:Name="SearchShell" Width="300" MinHeight="34" CornerRadius="6"
                            SnapsToDevicePixels="True" Background="{StaticResource BrushBackground}"
                            BorderThickness="1" MouseLeftButtonDown="SearchShell_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                    </Trigger>
                                    <!-- 聚焦优先级更高（鼠标还停在框上也该按聚焦色画）。
                                         IsKeyboardFocusWithin 覆盖整棵子树 = CSS 的 :focus-within，
                                         因此不再需要按名字去盯那个输入框。
                                         **描边粗细恒定 1**：以前聚焦时改成 1.5，整框外层会随聚焦 / 失焦
                                         长高、变宽 1px（点进框里就抖一下），和相邻的排序下拉也对不齐。
                                         "加粗"的观感改由下面那圈内侧描边给 -->
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <!-- 聚焦内圈：贴着外侧描边再画一圈（1+1 = 聚焦时看着像 2px 强调），
                                 **不参与布局**（只是无填充的描边，期望尺寸才 2×2），
                                 所以聚焦 / 失焦时框的尺寸纹丝不动，只换描边颜色 + 多这圈 -->
                            <Border CornerRadius="5" BorderThickness="1" Margin="0"
                                    SnapsToDevicePixels="True"
                                    BorderBrush="{StaticResource BrushBorderFocus}"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding IsKeyboardFocusWithin,
                                                                   RelativeSource={RelativeSource AncestorType=Border}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- 前导放大镜：浮在左边那条 28 的槽里（纯装饰，不挡点击）。
                                 **用固定高的格子把字形居中**（Height 22 + 顶边距 5 = 第一行内容的
                                 y 范围 5..27），而不是拿 Margin 去凑字体高度——换字体、换字号都不会再偏 -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Height="22" Margin="9,5,0,0" IsHitTestVisible="False">
                                <TextBlock Text="&#xF002;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </Grid>

                            <!-- 胶囊 + 输入框：**同一个 WrapPanel**，输入框是最后一项 →
                                 光标永远跟在最后一个胶囊后面，放不下就换行、框跟着长高。
                                 ItemsSource 用 CompositeCollection（胶囊集合 + 末尾的输入框），
                                 这样只有**一层** WrapPanel：换行才连续（把输入框放在 ItemsControl 外，
                                 它会被当成一个整块、永远独占一行）。
                                 社区同款坑：① 不能再设 ItemTemplate —— 它会连输入框一起套上胶囊模板，
                                 得改成 ItemsControl.Resources 里的**隐式 DataTemplate**（按 DataType 匹配，
                                 末尾那个 TextBox 是 UIElement，会被原样呈现）；
                                 ② 输入框要给 MinWidth / MaxWidth，否则没字时缩成一条线、字一长又把框撑爆。
                                **高度预算**（治"加第一个胶囊就跳一下高"）：这一行恒为 26 高
                                = 22（胶囊高 = 输入框高）+ 上下各 2 外边距（**胶囊与输入框都给 2，对称**）；
                                再各留 3 → 内容 32、外壳 34，与空态**完全一致**；
                                之后每多一个胶囊只要不换行就不再变高，换行才整行 +26 -->
                            <ItemsControl x:Name="ChipList" Margin="28,3,28,3">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.Resources>
                                    <!-- 胶囊（只匹配 WtLiveSearchChip）。
                                         竖直外边距**对称**（2 / 2，曾经是只有下边 2+2），行高才与只有输入框时一致——
                                         否则空态 34、加第一个胶囊 38（那 4px 还全在下边，把胶囊顶得"偏上"）。
                                         左右 4 是胶囊之间的间距 -->
                                    <DataTemplate DataType="{x:Type vm:WtLiveSearchChip}">
                                        <Border Background="{StaticResource BrushSurface2}" CornerRadius="10"
                                                Padding="8,2,4,2" Margin="0,2,4,2" SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushPrimary}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="5,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <!-- 删掉这一个胶囊（退格删最后一个是同一条路，见 code-behind）。
                                                     Focusable=False：点它别把键盘焦点从输入框抢走。
                                                     底色透明 + 字色 muted：悬停时 IconButton 提亮字色，
                                                     用默认底色则与胶囊底色同为 Surface2、看不出悬停 -->
                                                <Button Content="&#xF00D;" Margin="2,0,0,0" Focusable="False"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource BrushTextMuted}"
                                                        ToolTip="{loc:Loc common.close}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.WtLive.RemoveChipCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Width" Value="18"/>
                                                            <Setter Property="Height" Value="18"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>

                                <ItemsControl.ItemsSource>
                                    <CompositeCollection>
                                        <!-- CollectionContainer 不在可视树里、继承不到 DataContext，必须显式给 Source。
                                             **踩过的坑**：x:Reference 不能指向「包含这个绑定的元素」（外壳 SearchShell、
                                             甚至 XAML 根 UserControl 都算）—— 那会构成循环依赖，加载时直接
                                             XamlParseException（MarkupExtension.ProvideValue 抛「循环依赖」），
                                             而且只在控件实例化时才炸，编译期看不出来。
                                             所以借用**同级**、同一个 DataContext 的 Popup 当锚点（它声明在本 ItemsControl 之后，
                                             属前向引用，合法）。ElementName 与无 Source 的 Binding 都拿不到 DataContext，
                                             已实测不可用。改这里时别删掉这个 Popup。 -->
                                        <CollectionContainer
                                            Collection="{Binding DataContext.WtLive.Chips,
                                                         Source={x:Reference SearchPopup}}"/>

                                        <!-- 末尾的输入框：高 22 = 胶囊高，两者文字中线才在同一水平线上；
                                             上下也给 2 外边距 → 与胶囊**行高一致**（见上「高度预算」） -->
                                        <TextBox x:Name="SearchBox" Style="{StaticResource BaseTextBox}"
                                                 Height="22" MinWidth="80" MaxWidth="240" Padding="2,0,0,0"
                                                 Margin="0,2,0,2" VerticalAlignment="Top"
                                                 Text="{Binding WtLive.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                                 LostKeyboardFocus="SearchBox_LostKeyboardFocus">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <!-- 只留内容宿主：**描边只由外壳画**
                                                         （BaseTextBox 的模板聚焦时会把内框硬改成 1.5px 蓝色，
                                                          写在 ControlTemplate.Triggers 里，外面压不住） -->
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  VerticalScrollBarVisibility="Hidden"
                                                                  HorizontalScrollBarVisibility="Hidden"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                    </CompositeCollection>
                                </ItemsControl.ItemsSource>
                            </ItemsControl>

                        <!-- 占位文案（框里空着才显示）：**水平居中**。
                             它与输入文字是两个各自独立的元素，因此提示居中、输入仍左对齐互不影响；
                             左右各 30 是**对称**内缩（避开左侧放大镜与右侧「×」），
                             这样居中点正好落在输入框中心，而不是被单侧留白推偏。
                             判据用 HasSearchInput：有胶囊时（哪怕输入框是空的）也不该再提示"搜索载具 / #标签" -->
                        <TextBlock Text="{loc:Loc wtlive.search.placeholder}" Margin="30,0,30,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.HasSearchInput}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 清空（有文字或有胶囊才出现）：一次清掉条件与输入。
                             顶边距 4 → 24 高的按钮中线落在 16，与第一行胶囊 / 输入框同一中轴 -->
                        <Button Content="&#xF00D;"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0" ToolTip="{loc:Loc wtlive.search.clear}"
                                Command="{Binding WtLive.ClearSearchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.HasSearchInput}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 搜索下拉。StaysOpen=True + 手动开合：项是**不可聚焦**的按钮，
                             点它不会让输入框失焦，因此不会出现"点不下去"（见 code-behind 的失焦处理） -->
                        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom" VerticalOffset="4"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding WtLive.IsSuggestionsOpen}">
                            <!-- 与主题 ComboBox 下拉同一套外观（底 + 描边 + 圆角 8 + 投影） -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" MinWidth="300" MaxWidth="460"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                      Opacity="0.14" Color="{StaticResource ColorShadow}"/>
                                </Border.Effect>

                                <ItemsControl ItemsSource="{Binding WtLive.Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Focusable="False" HorizontalContentAlignment="Stretch"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.WtLive.ApplySuggestionCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" CornerRadius="6"
                                                                            Background="{TemplateBinding Background}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <!-- 鼠标悬停与键盘高亮用同一个底色 -->
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background"
                                                                                    Value="{StaticResource BrushSurface}"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                            <Setter TargetName="bd" Property="Background"
                                                                                    Value="{StaticResource BrushSurface}"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" Width="20" VerticalAlignment="Center"
                                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>

                    <Button Content="&#xF021;" Style="{StaticResource IconButton}" Width="34" Height="34"
                            FontSize="14" Margin="8,0,0,0" ToolTip="{loc:Loc wtlive.refresh}"
                            Command="{Binding WtLive.RefreshCommand}"/>
                </StackPanel>

                <!-- 当前查询摘要：载具 / 关键词在搜索框里都只是文字，这里点明走的是哪条通道 -->
                <TextBlock Text="{Binding WtLive.ActiveFilterText}" HorizontalAlignment="Right"
                           Margin="0,6,0,0" FontSize="12" MaxWidth="420"
                           Foreground="{StaticResource BrushPrimary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WtLive.HasFilter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ListScroll_ScrollChanged"
                          PreviewMouseDown="ListScroll_PreviewMouseDown">
                <StackPanel>
                    <ItemsControl x:Name="CardList" ItemsSource="{Binding WtLive.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctrl:MasonryPanel TargetItemWidth="240" MinItemWidth="170"
                                                   MaxItemWidth="360" MaxColumns="5" ItemGap="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 卡片：白底 + 1px 描边 + 圆角 12。不用 Card 样式（它带阴影：
                                     瀑布流一屏几十张，逐张阴影的开销不值当，改用描边分层）。
                                     整张卡片可点 → 打开详情浮窗（右下角「下载」按钮自己处理点击，不冒泡到这里） -->
                                <Border Background="{StaticResource BrushBackground}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="12" SnapsToDevicePixels="True"
                                        Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <StackPanel>
                                        <!-- 缩略图：圆角裁剪在 code-behind 做（ClipToBounds 不认 CornerRadius） -->
                                        <Border x:Name="Thumb" Background="{StaticResource BrushSurface}" CornerRadius="10"
                                                ClipToBounds="True" SizeChanged="Thumbnail_SizeChanged">
                                            <Grid>
                                                <!-- 加载中：转圈 +（**转够 5s** 才浮现的）「重新加载」。
                                                     **未加载的卡片不给占位图标**——进页面就有几十张图在排队取图（并发 4），
                                                     静态图标会让人以为这些帖子本来就没图 -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                                        <Viewbox.Style>
                                                            <Style TargetType="Viewbox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Viewbox.Style>
                                                        <ContentControl Style="{StaticResource BusySpinner}"/>
                                                    </Viewbox>

                                                    <!-- 5s 还没好（SlowLoadWatcher）→ 给个出口，别让人对着圈干等。
                                                         命令在 WtLive 上（**不是** MainViewModel 上）：少写一层 .WtLive 时
                                                         WPF 只会静默绑定失败——按钮点下去什么都不发生，最难查的一类 bug -->
                                                    <Button Content="{loc:Loc wtlive.reload}"
                                                            Margin="0,8,0,0" HorizontalAlignment="Center"
                                                            MinWidth="72" Height="26" Padding="10,0" FontSize="12"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.WtLive.ReloadThumbnailCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsThumbnailLoading}" Value="True"/>
                                                                            <Condition Binding="{Binding CanReloadThumbnail}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <!-- 无预览图 / 加载失败：占位图标（失败不转圈，否则永远在"加载"） -->
                                                <TextBlock Text="&#xF03E;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="22" Foreground="{StaticResource BrushTextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- 占位高度按**图片实际可用宽度**算：列宽比它宽（差卡片内边距 + 描边），
                                                         用列宽会把图片左右各裁掉十几像素（见 AspectRatioHeightConverter） -->
                                                    <Image.Height>
                                                        <MultiBinding Converter="{StaticResource AspectRatioHeight}">
                                                            <Binding Path="ColumnWidth"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type ctrl:MasonryPanel}}"/>
                                                            <Binding Path="Ratio"/>
                                                            <Binding Path="ActualWidth" ElementName="Thumb"/>
                                                        </MultiBinding>
                                                    </Image.Height>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" Margin="2,10,2,0" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- 副标题行 + 右下角「下载」：点它直接进「从 WT Live 下载」确认窗口，
                                             帖子链接已填好并自动读取（省掉"复制链接 → 粘贴 → 读取"三步）。
                                             没有站内附件的帖子不给按钮——那条路只会得到一句"没有可下载的文件" -->
                                        <Grid Margin="2,1,2,0">
                                            <TextBlock Text="{Binding MetaText}" Margin="0,0,26,0"
                                                       Style="{StaticResource PageSubtitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="&#xF019;" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{loc:Loc wtlive.card.download}"
                                                    CommandParameter="{Binding PostUrl}"
                                                    Command="{Binding DataContext.Skins.OpenWtLiveImportCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFile}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 页脚（已有内容时）：加载下一页 / 失败重试 / 已到底，三者互斥 -->
                    <Grid Margin="0,16,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.IsLoading}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ContentControl Style="{StaticResource BusySpinner}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc wtlive.list.loading}" Margin="10,0,0,0"
                                       Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.HasError}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xF06A;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WtLive.ErrorMessage}" Margin="8,0,12,0" MaxWidth="420"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushDanger}"/>
                            <Button Content="{loc:Loc wtlive.list.retry}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding WtLive.RetryCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc wtlive.list.end}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.IsExhausted}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.HasItems}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 列表还空着时的整屏状态：首次加载 / 首次失败 / 没有结果（互斥） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ContentControl Style="{StaticResource BusySpinner}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc wtlive.list.loading}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.HasError}" Value="True"/>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xF06A;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding WtLive.ErrorMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{StaticResource BrushDanger}"/>
                <Button Content="{loc:Loc wtlive.list.retry}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center" Margin="0,14,0,0" MinWidth="88"
                        Command="{Binding WtLive.RetryCommand}"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding WtLive.HasItems}" Value="False"/>
                                    <Condition Binding="{Binding WtLive.IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding WtLive.HasError}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xF0ED;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc wtlive.list.empty}" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc wtlive.list.emptyHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
