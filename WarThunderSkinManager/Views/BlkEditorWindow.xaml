<Window x:Class="WarThunderSkinManager.Views.BlkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        Title="{Binding Title}"
        Width="760" Height="620"
        MinWidth="600" MinHeight="360"
        WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="symbols_skyquake, Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="20,16,20,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- 位置级：该位置名下的块（逐块改原文 / 标记不输出） -->
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowBlocks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Loc pkg.editor.blocks.index}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding Index}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding To}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{loc:Loc pkg.editor.blocks.changed}" FontSize="11"
                                                       Foreground="{StaticResource BrushDanger}" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76"
                                                     FontSize="12" FontFamily="Consolas"
                                                     Style="{StaticResource BaseTextBox}"/>

                                            <CheckBox Grid.Column="1" Content="{loc:Loc pkg.editor.blocks.delete}"
                                                      IsChecked="{Binding Deleted}" Margin="12,0,0,0"
                                                      VerticalAlignment="Top"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 该位置没有块时的提示（空白窗口会让人以为坏了） -->
                    <TextBlock Text="{loc:Loc pkg.editor.blkEditor.empty}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoBlocks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 包级：额外参数块（单文本框，清空 = 删除） -->
                    <TextBox Text="{Binding ExtraBlkText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="420"
                             FontSize="12" FontFamily="Consolas">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowExtra}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,16">
                <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"/>
                <Button Content="{loc:Loc common.ok}" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
