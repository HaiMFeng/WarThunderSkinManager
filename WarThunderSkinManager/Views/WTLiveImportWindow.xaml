<Window x:Class="WarThunderSkinManager.Views.WTLiveImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        Title="{loc:Loc wtlive.title}"
        Width="560" MinHeight="320"
        WindowStyle="None" ShowInTaskbar="False" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" MinWidth="480"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：整个标题栏保持客户区（与其他进度窗一致）——
             非客户区标题栏会吞掉按钮的命中测试（悬停 / 点击全部失效） -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}"
            Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动；X = 关闭） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{loc:Loc wtlive.title}" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,14,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 网址输入 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Style="{StaticResource BaseTextBox}" VerticalContentAlignment="Center"
                             KeyDown="UrlBox_KeyDown"/>
                    <Button x:Name="FetchButton" Grid.Column="1" Content="{loc:Loc wtlive.fetch}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Fetch_Click"/>
                </Grid>

                <!-- 提示 / 错误 -->
                <TextBlock x:Name="HintText" Grid.Row="1" Text="{loc:Loc wtlive.url.hint}"
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- 涂装信息（读取成功后显示）；预览图不放确认窗内联加载（国内加载慢会卡住界面），
                     下载导入完成后在后台取原图设为涂装包预览 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                              Visibility="Collapsed" x:Name="InfoPanel">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc wtlive.author}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="AuthorText" Margin="12,0,24,0"/>
                            <TextBlock Text="{loc:Loc wtlive.file}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="FileText" Margin="12,0,24,0"/>
                            <TextBlock Text="{loc:Loc wtlive.downloads}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DownloadsText" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc wtlive.displayName}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <TextBox x:Name="DisplayNameBox" Style="{StaticResource BaseTextBox}"/>
                        <TextBlock Text="{loc:Loc wtlive.description}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部动作 -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock x:Name="StartHint" HorizontalAlignment="Right"
                               Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StartButton" Content="{loc:Loc wtlive.start}"
                                Style="{StaticResource PrimaryButton}" Click="Start_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
