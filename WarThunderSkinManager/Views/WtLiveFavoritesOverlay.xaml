<UserControl x:Class="WarThunderSkinManager.Views.WtLiveFavoritesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- 「收藏的作者」（WtLive 页工具栏的星标按钮打开）：逐行 = 头像 / 昵称 / 取消收藏，
         拖动换位，点一行 = 按该作者搜索。可见性由 WtLive.Favorites.IsOpen 驱动；
         遮罩盖住内容区，点空白处 / Esc 关闭 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WtLive.Favorites.IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- 压暗底：挡住底下页面的交互；点空白处 = 关窗。
             ⚠️ 与详情浮窗同一条：关窗必须用 **MouseLeftButtonUp** —— 在 Down 里关的话，
             这次点击的 Up 会穿透到下面那个（刚露出来的）工具栏按钮上 -->
        <Border Background="{StaticResource BrushBackground}" Opacity="0.72"
                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"
                MouseLeftButtonUp="Backdrop_MouseLeftButtonUp"/>

        <!-- 列表是竖排窄条：Stretch + MaxWidth（宽度不跟内容走，见详情浮窗同一处注释） -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MaxWidth="420" Margin="48,40"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="12" Padding="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.26" Color="{StaticResource ColorShadow}"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题行：星标 + 标题 + 条数（右）关闭 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xF005;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc wtlive.favorites.title}" Margin="8,0,0,0"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WtLive.Favorites.CountText}" Margin="10,0,0,0"
                                   Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="&#xF00D;" Style="{StaticResource IconButton}"
                            Width="28" Height="28" FontSize="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="{loc:Loc common.close}"
                            Command="{Binding WtLive.Favorites.CloseCommand}"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AuthorList" ItemsSource="{Binding WtLive.Favorites.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 一行作者：**拖动换位**（DragOver 实时交换，见 code-behind），
                                     点一下 = 按该作者搜索；行尾「×」取消收藏（按钮自己吃掉点击，
                                     不会顺带触发整行那次搜索） -->
                                <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="8"
                                        Cursor="Hand" AllowDrop="True"
                                        ToolTip="{loc:Loc wtlive.favorites.search}"
                                        PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown"
                                        MouseMove="Row_MouseMove"
                                        DragOver="Row_DragOver"
                                        Drop="Row_Drop"
                                        MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource BrushSurface2}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 圆形头像：Border 的圆角裁不到子元素，所以显式给椭圆 Clip。
                                             没有头像 / 还没下好 → 占位人形图标 -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource BrushBackground}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1">
                                            <Border.Clip>
                                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                            </Border.Clip>
                                            <Grid>
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                <TextBlock Text="&#xF007;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Avatar}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Margin="10,0,8,0"
                                                   VerticalAlignment="Center" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="2" Content="&#xF00D;"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="{loc:Loc wtlive.favorites.remove}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.WtLive.Favorites.RemoveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 一位都没收藏：说明在哪儿收藏（不留一片空白） -->
                <TextBlock Grid.Row="1" Text="{loc:Loc wtlive.favorites.empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="280" TextAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WtLive.Favorites.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
