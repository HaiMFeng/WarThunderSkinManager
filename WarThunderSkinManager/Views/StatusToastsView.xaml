<UserControl x:Class="WarThunderSkinManager.Views.StatusToastsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             xmlns:services="clr-namespace:WarThunderSkinManager.Services">
    <!-- 顶部居中的气泡提示（§2.7）：最多 4 条纵向堆叠（上限在服务侧），每条底部带剩余时间进度条，
         点击气泡任意位置立即消除该条。
         ItemsSource 在 code-behind 里直接绑 ToastService —— 本控件挂在窗口层，DataContext 是
         MainViewModel，与提示队列无关，不去绕 DataContext。
         空白处不挡命中测试：ItemsControl 自身没背景，只有气泡 Border 有。 -->
    <ItemsControl x:Name="ToastList" HorizontalAlignment="Center" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- 气泡：进入 / 退出动画都由触发器驱动；进度条与文案**叠放**（同一层 Grid），
                     因此它贴底却不参与气泡高度计算。
                     初始状态（Opacity=0 / Y=-8）直接写在 XAML 上 → 第一帧就处于"未落定"的样子，
                     不会先实心闪一下再淡入。点击任意位置 = 消除。 -->
                <Grid x:Name="ToastRoot" Margin="0,0,0,8" Opacity="0"
                      Cursor="Hand" MouseLeftButtonUp="Toast_Click"
                      ToolTip="{loc:Loc common.dismissHint}">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ToastShift" Y="-8"/>
                    </Grid.RenderTransform>

                    <Border x:Name="ToastCard" CornerRadius="10"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                              Opacity="0.18" Color="{StaticResource ColorShadow}"/>
                        </Border.Effect>
                        <Grid>
                            <!-- 文案靠自身 Margin 撑出内边距（Border **不设 Padding**，
                                 这样进度条才能直接顶到内边框上）。
                                 **上下边距必须相等**：气泡高度 = 文案高 + 上下各 10 → 文字天然垂直居中；
                                 曾经把下边距写成 12（想给进度条"让位"），结果文字被顶得偏上。 -->
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="520"
                                       Margin="16,10"
                                       Foreground="{StaticResource BrushText}"/>
                            <!-- 进度条：与文案**同层叠放** + `VerticalAlignment=Bottom` → 贴着内底边，
                                 完全不增加气泡高度。`Margin=0` → 满宽铺到内边框（两端会落在气泡的
                                 圆角区域内，这是刻意的：不做圆角裁剪，让这条线真正横贯底边）。
                                 从左端（0）长到满（1）。Duration 取服务里的同一个值（x:Static，不走 Binding ——
                                 动画属性上的 Binding 依赖 DataContext 继承链，在模板里容易失效）。
                                 动画跑在**合成线程**，不占 UI 线程：多条并发也不增加刷新负担。 -->
                            <Border x:Name="ToastBar" Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource BrushPrimary}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <!-- 载入即**进入**：淡入 + 自上而下落定 8px，同时起进度条（2 秒走满） -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ToastRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="ToastShift"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ToastBar"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0" To="1"
                                                 Duration="{x:Static services:ToastService.DefaultLifetimeDuration}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <!-- **退出动画不在这里**：模板触发器里的 `DataTrigger.EnterActions` 实测不生效
                         （`EventTrigger.Loaded` 这类"元素自身事件"能起，但"属性变化驱动"的 EnterActions
                         在这条路径上起不来）。退场动画改由 code-behind 直接驱动，
                         见 StatusToastsView.xaml.cs 的 OnToastPropertyChanged。 -->
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
