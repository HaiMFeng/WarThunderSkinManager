<Window x:Class="WarThunderSkinManager.Views.PasswordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- 图标 + 说明 -->
            <Grid Grid.Row="1" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="26" Text="&#xE72E;"
                           Foreground="{StaticResource BrushWarning}" VerticalAlignment="Top" Margin="0,0,14,0"/>
                <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                           VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
            </Grid>

            <!-- 密码输入 -->
            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Margin="20,14,20,0"
                         Style="{StaticResource BasePasswordBox}"
                         KeyDown="Password_KeyDown"/>

            <!-- 密码错误的提示 -->
            <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="20,8,20,0" TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource BrushDanger}" Visibility="Collapsed"/>

            <!-- 按钮（文案在代码里按语言设置，见 Configure） -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,20,20,18">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
