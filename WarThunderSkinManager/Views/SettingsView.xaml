<UserControl x:Class="WarThunderSkinManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc settings.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc settings.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

            <!-- 目录配置（必须设置在前：三个目录决定程序能否工作） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.directories}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.userSkins.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.UserSkinsDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseUserSkinsCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.UserSkinsDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.userSkins.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.resource.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.ResourceDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseResourceCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ResourceDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.resource.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.config.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.ConfigDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseConfigCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ConfigDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.config.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 界面语言（功能设计 §3.9）：切换立即生效，载具自动译名按新语言重新检索 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.language.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 主题（界面设计规范 §3）：内置四套配色，重启生效 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.theme.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource BaseComboBox}" Width="220"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{loc:Loc settings.theme.restart}" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 多源复用（§3.13）：开启后左侧导航出现「多源复用」页；关闭只停用，组数据保留 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.partReuse}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.partReuse.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.partReuse.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.PartReuseEnabled}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据表（可单独替换更新） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.datatables}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.datatables.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DataTablesDirectory}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc settings.datatables.export}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportDataTablesCommand}"/>
                        <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding OpenDataTablesFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 资源库维护（§4）：外部改动的手动全量同步 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.rebuild.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.rebuild.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.rebuild.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Command="{Binding RebuildLibraryCommand}"/>
                </StackPanel>
            </Border>

            <!-- 存储维护（blob 回收，功能设计 §6.5） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.gc.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.gc.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.gc.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Command="{Binding GcBlobsCommand}"/>
                </StackPanel>
            </Border>

            <!-- 危险操作 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.danger}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.danger.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.reset}" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Command="{Binding ResetDataCommand}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="{loc:Loc settings.save}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 关于：固定在右侧空白区，不随设置内容滚动；Logo + 作者与版本（来源 csproj，经程序集特性读取） -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="250"
                VerticalAlignment="Top" Margin="0,20,16,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.about}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                <!-- 大尺寸镂空 Logo：OpacityMask 以主题色染色（灰轮廓图随亮暗主题适配） -->
                <Grid Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <Rectangle Fill="{StaticResource BrushTextSecondary}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Assets/logo-outline.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc settings.about.author}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0">
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AuthorUrl}"
                                   Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                            <Run Text="{Binding AboutAuthor, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc settings.about.version}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                               ToolTip="{loc:Loc settings.about.versionTip}">
                        <Hyperlink Command="{Binding CopyVersionCommand}"
                                   Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                            <Run Text="{Binding AboutVersion, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{loc:Loc settings.about.openProject}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding ProjectUrl}"/>
                    <Button Content="{loc:Loc settings.about.releases}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding ReleasesUrl}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
