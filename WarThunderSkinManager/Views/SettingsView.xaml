<UserControl x:Class="WarThunderSkinManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             xmlns:controls="clr-namespace:WarThunderSkinManager.Controls">

    <UserControl.Resources>
        <!-- 占比 → 星宽：存储条的三段按**同一比例尺**分割可用宽度（见 Controls/ProportionToStarLengthConverter） -->
        <controls:ProportionToStarLengthConverter x:Key="StarLength"/>
    </UserControl.Resources>

    <Grid>
        <!-- 单列内容（保留这层 Grid 只是沿用页面骨架，不再改整页缩进）：
             「关于」与「应用自更新」已迁到「关于」页（Views/AboutView.xaml） -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc settings.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc settings.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

            <!-- 目录配置（必须设置在前：三个目录决定程序能否工作）。
                 目录框**只读**：路径只能由「更改」走目录选择器改 —— 手输容易写出不存在的路径 / 打错的盘符，
                 而这里每个目录都牵着迁移、服务重配与重扫，输错一次代价不小（只读仍可选中复制）。
                 只读态由 BaseTextBox 的 IsReadOnly 触发器给出（背景变浅一档，一眼看出不能编辑）。
                 绑定用**默认的失焦更新**：既然只有选择器会改它，就不存在"逐键改 Config"的问题 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.directories}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.userSkins.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     IsReadOnly="True"
                                     Text="{Binding Config.UserSkinsDirectory}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.change}" Style="{StaticResource SecondaryButton}"
                                        Foreground="{StaticResource BrushDanger}"
                                        Command="{Binding BrowseUserSkinsCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.UserSkinsDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.userSkins.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.resource.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     IsReadOnly="True"
                                     Text="{Binding Config.ResourceDirectory}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.change}" Style="{StaticResource SecondaryButton}"
                                        Foreground="{StaticResource BrushDanger}"
                                        Command="{Binding BrowseResourceCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ResourceDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.resource.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.config.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     IsReadOnly="True"
                                     Text="{Binding Config.ConfigDirectory}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.change}" Style="{StaticResource SecondaryButton}"
                                        Foreground="{StaticResource BrushDanger}"
                                        Command="{Binding BrowseConfigCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ConfigDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.config.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Saves 目录（§3.14 游戏内同步）：首次启动自动探测，不参与目录迁移（游戏数据非程序所有） -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{loc:Loc settings.saves.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     IsReadOnly="True"
                                     Text="{Binding Config.SavesDirectory}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.change}" Style="{StaticResource SecondaryButton}"
                                        Foreground="{StaticResource BrushDanger}"
                                        Command="{Binding BrowseSavesCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.SavesDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.saves.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 界面语言（功能设计 §3.9）：切换立即生效，载具自动译名按新语言重新检索 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.language.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 主题（界面设计规范 §3）：内置四套配色，重启生效 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.theme.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource BaseComboBox}" Width="220"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{loc:Loc settings.theme.restart}" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- WT Live 卡片：图片清晰度（站点多级变体，见 Services.WtLiveQualityCatalog）
                 + 预览图磁盘缓存上限（LRU 回收，见 Services.WtLivePreviewCache） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.wtliveQuality}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.wtliveQuality.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="{loc:Loc settings.wtliveQuality.label}" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding WtLiveQualities}"
                              SelectedItem="{Binding SelectedWtLiveQuality, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{loc:Loc settings.wtliveCacheSize}" Style="{StaticResource FieldLabel}"
                               Margin="0,18,0,6"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding WtLiveCacheSizes}"
                              SelectedItem="{Binding SelectedWtLiveCacheSize, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:Loc settings.wtliveCacheSize.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 进阶功能（§3.13 多源复用 / §7.3 手动编辑 blk）：面向懂技术的用户 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.advanced}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.advanced.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- 多源复用（§3.13）：开启后左侧导航出现「多源复用」页；关闭只停用，组数据保留 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.partReuse.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.PartReuseEnabled}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.partReuse.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,6,0,16"/>

                    <!-- 手动编辑 blk（§7.3）：开启后属性页出现「编辑 blk 块」 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.manualBlkEdit.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.ManualBlkEdit}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.manualBlkEdit.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 游戏内同步涂装选择（§3.14）：激活状态写入游戏存档的 userSkins，免去进机库手动选择 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel IsEnabled="{Binding GameSyncBlockEnabled}">
                    <TextBlock Text="{loc:Loc settings.gameSync}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.gameSync.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.gameSync.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.GameSyncEnabled}"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                IsEnabled="{Binding Config.GameSyncEnabled, FallbackValue=True}">
                        <TextBlock Text="{loc:Loc settings.gameSync.account}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource BaseComboBox}" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding GameAccounts}"
                                  SelectedItem="{Binding SelectedGameAccount, Mode=TwoWay}"/>
                        <TextBlock Text="{loc:Loc settings.gameSync.accountHint}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Loc settings.gameSync.write}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding WriteGameSkinsCommand}"/>
                            <Button Content="{loc:Loc settings.gameSync.precreate}" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Command="{Binding PreCreateGameSkinsCommand}"
                                    ToolTip="{loc:Loc settings.gameSync.precreate.hint}"/>
                            <Button Content="{loc:Loc settings.gameSync.overwrite}" Style="{StaticResource DangerButton}"
                                    Margin="8,0,0,0" Command="{Binding OverwriteGameSkinsCommand}"
                                    ToolTip="{loc:Loc settings.gameSync.overwrite}"/>
                        </StackPanel>

                        <!-- 最近一次同步结果（含「游戏运行中已跳过」等提示）；无内容时收起，不留空白 -->
                        <TextBlock Text="{Binding GameSyncStatus}"
                                   TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameSyncStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据表（可单独替换更新） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.datatables}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.datatables.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DataTablesDirectory}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc settings.datatables.export}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportDataTablesCommand}"/>
                        <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding OpenDataTablesFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 资源库维护（§4）：外部改动的手动全量同步 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.rebuild.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.rebuild.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.rebuild.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Command="{Binding RebuildLibraryCommand}"/>
                </StackPanel>
            </Border>

            <!-- 存储维护（blob 回收，功能设计 §6.5）＋ 横向存储条（§4 存储管理） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.gc.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.gc.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- 横向存储条：**全长 = 资源目录所在磁盘的总容量**，三段 = 本程序资源目录占用 /
                         该磁盘其他内容占用 / 剩余可用（同一比例尺；数据见 Services/Storage/StorageUsageService）。
                         宽度走**星宽**（占比经 ProportionToStarLength 换算）→ 条随卡片宽度自适应，
                         不必把条的像素宽回推到 ViewModel；圆角由 code-behind 在 SizeChanged 里挂
                         RectangleGeometry 裁（WPF 没有内建圆角 Clip，同「界面设计规范」§2.7）。
                         **卡片里不放任何动态文字**：统计开始 / 收尾 / 读不到磁盘信息一律走顶部气泡
                         （见 MainViewModel.StartStorageMeasure 与 ShouldAnnounceStorageCompletion）——
                         说明行一会儿出现一会儿消失会把下面那个按钮顶得上下跳。
                         没有能画的数字时本块整体收起，卡片高度稳定。 -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StorageUsage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 磁盘行：卷根 + 该磁盘总容量（左）＋ 重测（右）。
                             进入设置页 / 回收完成 / 换资源目录时会自动重测；库随时可能被导入撑大，故再给个显式入口 -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding StorageDiskText}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,0,36,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="&#xF021;" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="{loc:Loc settings.gc.storage.refresh}"
                                    Command="{Binding RefreshStorageUsageCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <!-- 统计中禁掉：这一趟本来就要把整个资源目录重枚举一遍，连点没有意义 -->
                                            <DataTrigger Binding="{Binding StorageMeasuring}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- 条本体：外壳只负责圆角描边与"剩余可用"的底色；三段各自的底色铺满自己那一列。
                             第三段不另画 —— 条的空余部分天然就是"剩余可用" -->
                        <Border Height="14" CornerRadius="6"
                                Background="{StaticResource BrushSurface2}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="StorageBar">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding StorageUsage.OwnFraction, Converter={StaticResource StarLength}}"/>
                                    <ColumnDefinition Width="{Binding StorageUsage.OtherFraction, Converter={StaticResource StarLength}}"/>
                                    <ColumnDefinition Width="{Binding StorageUsage.FreeFraction, Converter={StaticResource StarLength}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BrushPrimary}"/>
                                <Border Grid.Column="1" Background="{StaticResource BrushBorderStrong}"/>
                            </Grid>
                        </Border>

                        <!-- 图例：色块 + 名称 + 数值 + 占比（三行共用一套列，数值与占比右对齐成两列） -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc settings.gc.storage.own}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StorageUsage.OwnText}"
                                       Margin="12,0,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StorageUsage.OwnPercentText}"
                                       Width="52" TextAlignment="Right" Foreground="{StaticResource BrushTextMuted}"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorderStrong}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc settings.gc.storage.other}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StorageUsage.OtherText}"
                                       Margin="12,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StorageUsage.OtherPercentText}"
                                       Width="52" TextAlignment="Right" Margin="0,4,0,0"
                                       Foreground="{StaticResource BrushTextMuted}"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSurface2}"
                                         Stroke="{StaticResource BrushBorder}" StrokeThickness="1"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc settings.gc.storage.free}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StorageUsage.FreeText}"
                                       Margin="12,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding StorageUsage.FreePercentText}"
                                       Width="52" TextAlignment="Right" Margin="0,4,0,0"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </Grid>
                    </StackPanel>

                    <Button Content="{loc:Loc settings.gc.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding GcBlobsCommand}"/>
                </StackPanel>
            </Border>

            <!-- 危险操作 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.danger}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.danger.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.reset}" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Command="{Binding ResetDataCommand}"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
