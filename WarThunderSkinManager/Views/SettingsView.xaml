<UserControl x:Class="WarThunderSkinManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc settings.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc settings.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

            <!-- 目录配置（必须设置在前：三个目录决定程序能否工作） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.directories}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.userSkins.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.UserSkinsDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseUserSkinsCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.UserSkinsDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.userSkins.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc settings.resource.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.ResourceDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseResourceCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ResourceDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.resource.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc settings.config.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.ConfigDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseConfigCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.ConfigDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.config.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Saves 目录（§3.14 游戏内同步）：首次启动自动探测，不参与目录迁移（游戏数据非程序所有） -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{loc:Loc settings.saves.label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                                     Text="{Binding Config.SavesDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseSavesCommand}"/>
                                <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                                        CommandParameter="{Binding Config.SavesDirectory}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc settings.saves.hint}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 界面语言（功能设计 §3.9）：切换立即生效，载具自动译名按新语言重新检索 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.language.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 主题（界面设计规范 §3）：内置四套配色，重启生效 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.theme}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.theme.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource BaseComboBox}" Width="220"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{loc:Loc settings.theme.restart}" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Command="{Binding RestartCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- WT Live 卡片图片清晰度：站点为同一张预览图提供多级变体
                 （低清 _lq / 中清 _mq / 原图，见 Services.WtLiveQualityCatalog） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.wtliveQuality}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.wtliveQuality.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding WtLiveQualities}"
                              SelectedItem="{Binding SelectedWtLiveQuality, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 进阶功能（§3.13 多源复用 / §7.3 手动编辑 blk）：面向懂技术的用户 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.advanced}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.advanced.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- 多源复用（§3.13）：开启后左侧导航出现「多源复用」页；关闭只停用，组数据保留 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.partReuse.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.PartReuseEnabled}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.partReuse.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,6,0,16"/>

                    <!-- 手动编辑 blk（§7.3）：开启后属性页出现「编辑 blk 块」 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.manualBlkEdit.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.ManualBlkEdit}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.manualBlkEdit.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 游戏内同步涂装选择（§3.14）：激活状态写入游戏存档的 userSkins，免去进机库手动选择 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel IsEnabled="{Binding GameSyncBlockEnabled}">
                    <TextBlock Text="{loc:Loc settings.gameSync}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.gameSync.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc settings.gameSync.toggle}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="10,0,0,0"
                                  IsChecked="{Binding Config.GameSyncEnabled}"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                IsEnabled="{Binding Config.GameSyncEnabled, FallbackValue=True}">
                        <TextBlock Text="{loc:Loc settings.gameSync.account}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource BaseComboBox}" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding GameAccounts}"
                                  SelectedItem="{Binding SelectedGameAccount, Mode=TwoWay}"/>
                        <TextBlock Text="{loc:Loc settings.gameSync.accountHint}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Loc settings.gameSync.write}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding WriteGameSkinsCommand}"/>
                            <Button Content="{loc:Loc settings.gameSync.precreate}" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Command="{Binding PreCreateGameSkinsCommand}"
                                    ToolTip="{loc:Loc settings.gameSync.precreate.hint}"/>
                            <Button Content="{loc:Loc settings.gameSync.overwrite}" Style="{StaticResource DangerButton}"
                                    Margin="8,0,0,0" Command="{Binding OverwriteGameSkinsCommand}"
                                    ToolTip="{loc:Loc settings.gameSync.overwrite}"/>
                        </StackPanel>

                        <!-- 最近一次同步结果（含「游戏运行中已跳过」等提示）；无内容时收起，不留空白 -->
                        <TextBlock Text="{Binding GameSyncStatus}"
                                   TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameSyncStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据表（可单独替换更新） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.datatables}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.datatables.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DataTablesDirectory}" Style="{StaticResource FieldLabel}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc settings.datatables.export}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportDataTablesCommand}"/>
                        <Button Content="{loc:Loc common.open}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding OpenDataTablesFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 更新应用（§3.16）：安装器渠道 + 应用内自更新；规格见 docs/应用自更新设计.md。
                 放在「更新资源」上方：**程序版本**优先于数据表版本，两张卡措辞要能区分 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.appUpdate}" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.appUpdate.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- 状态行 -->
                    <TextBlock Text="{Binding AppUpdateText}" TextWrapping="Wrap"/>

                    <!-- 新版本详情（版本 / 日期 / 体积 + 说明要点，纯文本） -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdateHasDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding AppUpdateVersionText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding AppUpdateNotesText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>

                    <!-- 下载进度 -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdateIsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding AppUpdateProgress}"/>
                        <TextBlock Text="{Binding AppUpdateProgressText}" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>

                    <!-- 操作区：主操作随状态切换（更新 / 取消 / 立即重启并安装 / 检查更新）。
                         注意：给了 <Button.Style> 子元素就不能再写 Style= 属性（重复赋值会编译失败） -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc settings.appUpdate.update}"
                                Command="{Binding RunAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.cancel}"
                                Command="{Binding CancelAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateIsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.installNow}"
                                Command="{Binding InstallAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanInstall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.check}"
                                Command="{Binding CheckAppUpdateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanCheck}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 次操作：跳过此版本 / 撤销跳过 / 查看完整说明 -->
                        <Button Content="{loc:Loc settings.appUpdate.skip}" Margin="8,0,0,0"
                                Command="{Binding SkipAppUpdateVersionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.unskip}" Margin="8,0,0,0"
                                Command="{Binding UnskipAppUpdateVersionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateCanUnskip}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:Loc settings.appUpdate.notes}" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding AppUpdateReleaseUrl}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppUpdateHasDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 手动下载 / 旧版本：一律可达（网络不通、校验失败、便携运行时的兜底出口） -->
                        <Button Content="{loc:Loc settings.appUpdate.manual}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesUrl}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 更新资源（§3.15）：数据表可从上游仓库（War-Thunder-Datamine）检查 / 下载新版本。
                 IsEnabled 跟随 SettingsEnabled：应用更新进行中禁用（§7.3 第 4 条的"维护中闸门"） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    IsEnabled="{Binding SettingsEnabled}">
                <StackPanel IsEnabled="{Binding ResourceBlockEnabled}">
                    <TextBlock Text="{loc:Loc settings.resourceUpdate}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.resourceUpdate.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ResourceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="230"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="12,0,12,0"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <Button Grid.Column="2" Content="{loc:Loc settings.resource.update}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.UpdateResourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Loc settings.resource.check}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CheckResourceUpdatesCommand}"/>
                </StackPanel>
            </Border>

            <!-- 资源库维护（§4）：外部改动的手动全量同步 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.rebuild.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.rebuild.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.rebuild.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Command="{Binding RebuildLibraryCommand}"/>
                </StackPanel>
            </Border>

            <!-- 存储维护（blob 回收，功能设计 §6.5） -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.gc.title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.gc.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.gc.action}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Command="{Binding GcBlobsCommand}"/>
                </StackPanel>
            </Border>

            <!-- 危险操作 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.danger}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Loc settings.danger.hint}" Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Content="{loc:Loc settings.reset}" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Command="{Binding ResetDataCommand}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="{loc:Loc settings.save}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 关于：固定在右侧空白区，占满整列高度，不随设置内容滚动；Logo + 作者与版本（来源 csproj） -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="250"
                VerticalAlignment="Stretch" Margin="16,20,16,20">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.about}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                <!-- 大尺寸镂空 Logo：OpacityMask 以主题色染色（灰轮廓图随亮暗主题适配） -->
                <Grid Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <Rectangle Fill="{StaticResource BrushTextSecondary}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Assets/logo-outline.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>

                <!-- 使用声明（一句话版；完整声明见项目 README） -->
                <TextBlock Text="{loc:Loc settings.about.disclaimer}" Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc settings.about.author}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0">
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="{Binding AuthorUrl}"
                                   Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                            <Run Text="{Binding AboutAuthor, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc settings.about.version}" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                               ToolTip="{loc:Loc settings.about.versionTip}">
                        <Hyperlink Command="{Binding CopyVersionCommand}"
                                   Foreground="{StaticResource BrushPrimary}" TextDecorations="Underline">
                            <Run Text="{Binding AboutVersion, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- 构建短哈希：同一版本号可能对应多个构建（改了代码但没改版本号）——
                     没有这一行就没法确认"装的是哪次构建"（实测踩过：装的是修 bug 之前的构建却看不出来）。
                     没有哈希时（某些本地构建）整行隐藏 -->
                <TextBlock Text="{Binding AboutBuildText}" Margin="0,4,0,0" FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AboutBuildText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{loc:Loc settings.about.openProject}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding ProjectUrl}"/>
                    <Button Content="{loc:Loc settings.about.releases}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding ReleasesUrl}"/>
                </StackPanel>

                <!-- 桌面快捷方式（§7.4）：两态按钮（与安装器共用同一个固定名字，幂等）。
                     便携运行时也能用（指向当前 exe）——这是它存在的主要理由 -->
                <Button Content="{Binding DesktopShortcutActionText}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding ToggleDesktopShortcutCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
