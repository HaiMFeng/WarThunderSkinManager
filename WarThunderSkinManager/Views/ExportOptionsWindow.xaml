<Window x:Class="WarThunderSkinManager.Views.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        ShowInTaskbar="False"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动；标题文案在代码里按模式设置） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- 导出配置 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,0">

                <!-- 位置 -->
                <TextBlock Text="{loc:Loc export.location}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource BaseTextBox}" Margin="0,0,8,0"
                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="{loc:Loc common.browse}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseLocationCommand}"/>
                </Grid>

                <!-- 文件夹模式：是否创建文件夹 + 文件夹名 -->
                <StackPanel Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolderMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <CheckBox Content="{loc:Loc export.createFolder}" IsChecked="{Binding CreateFolder}"/>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsFolderMode}" Value="True"/>
                                            <Condition Binding="{Binding CreateFolder}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Loc export.folderName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource BaseTextBox}"
                                 Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 压缩包模式：压缩包名 + 格式 -->
                <StackPanel Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArchiveMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Loc export.archiveName}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource BaseTextBox}"
                             Text="{Binding ArchiveName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{loc:Loc export.format}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <ComboBox Style="{StaticResource BaseComboBox}" Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 共用：贴图文件命名规则 -->
                <TextBlock Text="{loc:Loc export.naming}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox Style="{StaticResource BaseComboBox}" Width="180" HorizontalAlignment="Left"
                          ItemsSource="{Binding NamingRules}"
                          SelectedItem="{Binding SelectedNaming, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding Error}" Margin="0,10,0,0" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource BrushDanger}"/>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,18">
                <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="{loc:Loc common.ok}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
