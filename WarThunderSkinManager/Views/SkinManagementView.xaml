<UserControl x:Class="WarThunderSkinManager.Views.SkinManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">

    <UserControl.Resources>
        <!-- 涂装包卡片容器：选中描边 + 拖放支持 -->
        <Style x:Key="PackageCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PackageCard_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="PackageCard_PreviewMouseRightButtonDown"/>
            <EventSetter Event="MouseMove" Handler="PackageCard_MouseMove"/>
            <EventSetter Event="DragOver" Handler="PackageCard_DragOver"/>
            <EventSetter Event="Drop" Handler="PackageCard_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter/>
                            <!-- 圆角与卡片一致（10）：环画在卡片边缘内侧，避免悬停 / 选中时圆角缝隙露出页面底色 -->
                            <Border x:Name="ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                            </Trigger>
                            <!-- 描边只表示「选中」（主色蓝）；「激活」用绿色徽标 + 绿色名字条，两种状态互不遮挡 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BrushPrimaryFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 + 操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc skins.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc skins.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{loc:Loc skins.importArchives}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding Skins.ImportArchivesCommand}"/>
                <Button Content="{loc:Loc skins.importFolder}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Skins.ImportFolderCommand}"/>
                <Button Content="{loc:Loc skins.importUserSkins}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Skins.ImportUserSkinsCommand}"/>
                <Button Content="{loc:Loc skins.wtlive}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding Skins.OpenWtLiveImportCommand}"/>

                <!-- WT Live 下载列表：图标 = 向下箭头 + 底部一横；悬停展开浮窗，移出关闭。
                     图标着色反映任务状态：**有下载 / 导入任务 = 主题主色**（一眼看出在忙），
                     无任务或全部结束 = 次要色（与按钮默认观感一致） -->
                <Button x:Name="WtLiveListButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                        Padding="10,6" MouseEnter="WtLiveListButton_MouseEnter" MouseLeave="WtLiveListButton_MouseLeave">
                    <TextBlock Text="&#xF0ED;" FontFamily="{StaticResource IconFont}" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasActiveDownloads}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- VerticalOffset：与下载按钮之间留出间距（贴太紧像按钮的一部分）；
                     横向偏移在代码里按"浮窗右缘对齐按钮右缘"动态设置（见 OpenWtLivePopup） -->
                <Popup x:Name="WtLiveListPopup" PlacementTarget="{Binding ElementName=WtLiveListButton}"
                       Placement="Bottom" VerticalOffset="8" StaysOpen="True" AllowsTransparency="True"
                       PopupAnimation="Fade" Width="360"
                       MouseEnter="WtLivePopup_MouseEnter" MouseLeave="WtLivePopup_MouseLeave">
                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc wtlive.list.title}" Style="{StaticResource FieldLabel}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Skins.WtLiveDownloads}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                                           Style="{StaticResource PageSubtitle}" Margin="12,0,0,0"/>
                                                <!-- 常驻「重试」（**图标按钮** &#xF021;，紧凑、不占文字宽度）：下载中也能点 =
                                                     掐断当前下载并重跑（察觉卡死时直接掐断）。
                                                     导入中 / 已完成后没有可重试的下载 → 隐藏（避免重复导入同一份压缩包）。
                                                     仅图标 → 必须带 ToolTip（说明自动重试节奏与停滞超时） -->
                                                <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Content="&#xF021;"
                                                        ToolTip="{loc:Loc wtlive.list.retryHint}"
                                                        Command="{Binding DataContext.Skins.RetryWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- 取消 / 移除（图标 &#xF00D;，**常驻**，在重试右侧）：
                                                     下载中 / 导入中 = **取消**（条目留列表、提示「已取消」、进度清零，可再重试）；
                                                     已取消 / 失败 / 已完成 = **从列表移除**（已取消状态再按一次即此语义） -->
                                                <Button Grid.Column="3" Margin="2,0,0,0" VerticalAlignment="Center"
                                                        Content="&#xF00D;"
                                                        Command="{Binding DataContext.Skins.CancelOrRemoveWtLiveDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.remove}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCancelable}" Value="True">
                                                                    <Setter Property="ToolTip" Value="{loc:Loc wtlive.list.cancel}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <!-- 进度指示条：下载阶段总进度（压缩包 80% + 预览图 20%）；
                                                 ScaleX 绑定 0..1 比例（ProgressBar 最小模板的 PART_Indicator 不会自动变宽） -->
                                            <Grid Height="4" Margin="0,4,0,0">
                                                <Border Background="{StaticResource BrushSurface2}" CornerRadius="2"/>
                                                <Border Background="{StaticResource BrushPrimary}" CornerRadius="2"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Progress}" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Loc wtlive.list.empty}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Skins.WtLiveDownloads.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- 国家横条 -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,14"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Skins.Countries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.Skins.SelectCountryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 主体：左侧载具（二级导航） + 右侧涂装包 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 载具列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc skins.vehicles.title}"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="8,6,0,8"/>

                    <!-- 载具搜索：匹配内部标识 / 显示名（与载具管理页一致，§3.10） -->
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
                        <TextBox Style="{StaticResource BaseTextBox}"
                                 Text="{Binding Skins.VehicleSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- 占位文案**居中**（输入文字仍左对齐——两者是各自独立的元素）；
                             左右对称留白，居中点即框中心；过长时省略号收尾 -->
                        <TextBlock Text="{loc:Loc vehicles.search}" Margin="8,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushTextMuted}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Skins.VehicleSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc skins.noSelection}"
                               Margin="8,0,8,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasVehicles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Style="{StaticResource SidebarListBox}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             ItemsSource="{Binding Skins.Vehicles}"
                             SelectedItem="{Binding Skins.SelectedVehicle, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 涂装包 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- 未选择载具 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xF1FC;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Loc skins.noSelection}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- 载具标题 + 包数量 + 同步 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Skins.SelectedVehicleTitle}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Skins.SelectedVehicleSubtitle}" Style="{StaticResource PageSubtitle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- 包计数 + 新建空白涂装包；无手动「同步」按钮：输出只在激活 / 属性页保存 / 取消激活时发生（§3.8） -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Skins.PackagesTitle}" FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                <Button Content="{loc:Loc pkg.create}" Style="{StaticResource SecondaryButton}"
                                        Margin="12,-4,0,0" Command="{Binding Skins.CreateBlankPackageCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 当前激活的涂装包：已激活 = 绿（与卡片激活态一致）；未激活 = 主色蓝（只是提示） -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Skins.ActivePackageText}" FontSize="13"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Skins.HasActivePackage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 卡片网格（列数与尺寸随窗口自适应；可拖动排序；右键菜单可激活/编辑等） -->
                        <ListBox x:Name="PackageList"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource PackageCardItem}"
                                 ItemsSource="{Binding Skins.Packages}"
                                 SelectedItem="{Binding Skins.SelectedPackage, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="PackageList_PreviewMouseLeftButtonDown"
                                 MouseDoubleClick="PackageList_MouseDoubleClick"
                                 Loaded="PackageList_Loaded"
                                 SizeChanged="PackageList_SizeChanged">
                            <!-- 右键菜单：作用于当前选中的涂装包 -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc pkg.activate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ActivatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Skins.SelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.deactivate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DeactivatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Loc pkg.edit}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.EditPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.duplicate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DuplicatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Loc pkg.export}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ExportPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.exportZip}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ExportPackageArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.delete}" Foreground="{StaticResource BrushDanger}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 初值仅兜底；实际尺寸在 Loaded / SizeChanged 时按可用宽度计算（见 .xaml.cs） -->
                                    <WrapPanel Orientation="Horizontal" ItemWidth="190" ItemHeight="137"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Background="{StaticResource BrushSurface}" CornerRadius="10"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                ClipToBounds="True" SnapsToDevicePixels="True"
                                                SizeChanged="ThumbBorder_SizeChanged">
                                            <Grid>
                                                <TextBlock Text="&#xF03E;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="22" Foreground="{StaticResource BrushTextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- UniformToFill 填满裁剪；对齐居中 → 裁掉的两侧均匀分布 -->
                                                <Image Stretch="UniformToFill" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Source="{Binding PreviewImage}"/>
                                            </Grid>
                                        </Border>
                                        <!-- 底部半透明名字条（激活的包用绿色条，与选中态的蓝色描边区分） -->
                                        <Border VerticalAlignment="Bottom"
                                                CornerRadius="0,0,10,10" Padding="9,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushCardOverlay}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushActiveStrip}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <!-- 卡片宽度有限 → 长名字按字符省略；悬停给出完整名字 -->
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushOnAccent}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                        </Border>
                                        <!-- 已激活标记（绿） -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8" Padding="8,3" CornerRadius="9"
                                                Background="{StaticResource BrushActiveFill}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Loc skins.active}" Foreground="{StaticResource BrushOnAccent}" FontSize="11"/>
                                        </Border>
                                        <!-- 资源包标记（紫）：只读素材（§3.5）；紫色与「跨载具」胶囊同源，灰底上辨识度足够 -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="8" Padding="8,3" CornerRadius="9"
                                                Background="{StaticResource BrushTagCrossBg}"
                                                BorderBrush="{StaticResource BrushTagCrossBorder}"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResource}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Loc pkg.card.resource}" Foreground="{StaticResource BrushTagCrossText}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
