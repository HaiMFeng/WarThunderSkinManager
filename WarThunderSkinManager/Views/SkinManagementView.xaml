<UserControl x:Class="WarThunderSkinManager.Views.SkinManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization">

    <UserControl.Resources>
        <!-- 涂装包卡片容器：选中描边 + 拖放支持 -->
        <Style x:Key="PackageCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PackageCard_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="PackageCard_PreviewMouseRightButtonDown"/>
            <EventSetter Event="MouseMove" Handler="PackageCard_MouseMove"/>
            <EventSetter Event="DragOver" Handler="PackageCard_DragOver"/>
            <EventSetter Event="Drop" Handler="PackageCard_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter/>
                            <!-- 圆角与卡片一致（10）：环画在卡片边缘内侧，避免悬停 / 选中时圆角缝隙露出页面底色 -->
                            <Border x:Name="ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                            </Trigger>
                            <!-- 描边只表示「选中」（主色蓝）；「激活」用绿色徽标 + 绿色名字条，两种状态互不遮挡 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BrushPrimaryFill}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 + 操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc skins.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc skins.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{loc:Loc skins.importFolder}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding Skins.ImportFolderCommand}"/>
                <Button Content="{loc:Loc skins.importUserSkins}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Skins.ImportUserSkinsCommand}"/>
                <Button Content="{loc:Loc skins.refresh}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding Skins.RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 国家横条 -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,14"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Skins.Countries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.Skins.SelectCountryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Count}" Margin="6,0,0,0" Opacity="0.65"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 主体：左侧载具（二级导航） + 右侧涂装包 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 载具列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc skins.vehicles.title}"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="8,6,0,8"/>

                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc skins.noSelection}"
                               Margin="8,0,8,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasVehicles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Style="{StaticResource SidebarListBox}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             ItemsSource="{Binding Skins.Vehicles}"
                             SelectedItem="{Binding Skins.SelectedVehicle, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 涂装包 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- 未选择载具 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{loc:Loc skins.noSelection}" Style="{StaticResource PageSubtitle}"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Skins.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- 载具标题 + 包数量 + 同步 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Skins.SelectedVehicleTitle}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Skins.SelectedVehicleSubtitle}" Style="{StaticResource PageSubtitle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- 无手动「同步」按钮：输出只在激活 / 切换激活包 / 属性页保存 / 取消激活时发生（§3.8） -->
                            <TextBlock Grid.Column="1" Text="{Binding Skins.PackagesTitle}" FontSize="13"
                                       Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Top"
                                       Margin="12,2,0,0"/>
                        </Grid>

                        <!-- 当前激活的涂装包：已激活 = 绿（与卡片激活态一致）；未激活 = 主色蓝（只是提示） -->
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Skins.ActivePackageText}" FontSize="13"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Skins.HasActivePackage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 卡片网格（列数与尺寸随窗口自适应；可拖动排序；右键菜单可激活/编辑等） -->
                        <ListBox x:Name="PackageList"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource PackageCardItem}"
                                 ItemsSource="{Binding Skins.Packages}"
                                 SelectedItem="{Binding Skins.SelectedPackage, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="PackageList_PreviewMouseLeftButtonDown"
                                 MouseDoubleClick="PackageList_MouseDoubleClick"
                                 Loaded="PackageList_Loaded"
                                 SizeChanged="PackageList_SizeChanged">
                            <!-- 右键菜单：作用于当前选中的涂装包 -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc pkg.activate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ActivatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.Skins.SelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.deactivate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DeactivatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:Loc pkg.edit}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.EditPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.duplicate}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DuplicatePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.export}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ExportPackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.exportZip}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.ExportPackageArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{loc:Loc pkg.delete}" Foreground="{StaticResource BrushDanger}"
                                              Command="{Binding PlacementTarget.DataContext.Skins.DeletePackageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              IsEnabled="{Binding PlacementTarget.DataContext.Skins.HasSelectedPackage, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 初值仅兜底；实际尺寸在 Loaded / SizeChanged 时按可用宽度计算（见 .xaml.cs） -->
                                    <WrapPanel Orientation="Horizontal" ItemWidth="190" ItemHeight="137"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Background="{StaticResource BrushSurface}" CornerRadius="10"
                                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                ClipToBounds="True" SnapsToDevicePixels="True"
                                                SizeChanged="ThumbBorder_SizeChanged">
                                            <Grid>
                                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="26" Foreground="{StaticResource BrushTextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Stretch="UniformToFill" Source="{Binding PreviewImage}"/>
                                            </Grid>
                                        </Border>
                                        <!-- 底部半透明名字条（激活的包用绿色条，与选中态的蓝色描边区分） -->
                                        <Border VerticalAlignment="Bottom"
                                                CornerRadius="0,0,10,10" Padding="9,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushCardOverlay}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushActiveStrip}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushOnAccent}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <!-- 已激活标记（绿） -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="8" Padding="8,3" CornerRadius="9"
                                                Background="{StaticResource BrushActiveFill}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{loc:Loc skins.active}" Foreground="{StaticResource BrushOnAccent}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
