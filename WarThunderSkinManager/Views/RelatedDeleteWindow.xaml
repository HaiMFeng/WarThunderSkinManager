<Window x:Class="WarThunderSkinManager.Views.RelatedDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        Width="520" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="symbols_skyquake, Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="HeaderText" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- 警告（危险色软底，与「清除数据」窗口同一形态） -->
            <Border Grid.Row="1" Margin="20,16,20,0"
                    Background="{StaticResource BrushDangerSoftBg}"
                    BorderBrush="{StaticResource BrushDangerSoftBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF071;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource BrushDanger}" VerticalAlignment="Top"
                               Margin="0,1,10,0"/>
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- 删除列表：每行「载具显示名.涂装包名」（如 VT-5.Skin1） -->
            <StackPanel Grid.Row="2" Margin="20,14,20,0">
                <TextBlock x:Name="ListHint" Style="{StaticResource PageSubtitle}"/>
                <ScrollViewer MaxHeight="300" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PackageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                                        Padding="2,7">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Display}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,16,20,18">
                <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"/>
                <Button x:Name="DeleteButton" Margin="8,0,0,0"
                        Style="{StaticResource DangerFillButton}" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
