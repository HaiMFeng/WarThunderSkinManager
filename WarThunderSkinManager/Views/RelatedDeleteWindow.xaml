<Window x:Class="WarThunderSkinManager.Views.RelatedDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
        Title="{Binding Title}"
        Width="540" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="symbols_skyquake, Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource BrushText}"
        Background="{StaticResource BrushBackground}">
    <Border BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Background="{StaticResource BrushCanvas}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}" Margin="14,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <!-- 警告（危险色软底，与「清除数据」窗口同一形态）。
                 图标与正文用**两列 Grid**：横向 StackPanel 会按"无限宽度"测量子元素 →
                 TextWrapping="Wrap" 永不换行、长文案溢出窗口被裁掉 -->
            <Border Grid.Row="1" Margin="20,16,20,0"
                    Background="{StaticResource BrushDangerSoftBg}"
                    BorderBrush="{StaticResource BrushDangerSoftBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xF071;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource BrushDanger}" VerticalAlignment="Top"
                               Margin="0,1,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding WarningText}" TextWrapping="Wrap"
                               FontSize="13" LineHeight="21"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </Grid>
            </Border>

            <!-- 连带清单：**可勾选**（默认全选），每行「载具显示名.涂装包名」（如 VT-5.Skin1） -->
            <StackPanel Grid.Row="2" Margin="20,14,20,0">
                <!-- 提示与计数**分两列**：同一格里叠放会让换行后的尾部被计数文字盖住（看不见） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{loc:Loc pkg.related.listHint}"
                               Style="{StaticResource PageSubtitle}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectionText}"
                               Style="{StaticResource PageSubtitle}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Border Margin="0,8,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="4,2">
                    <!-- 警告文案会换行（可能占好几行）+ 清单上限 240 → 整体高度稳定落在窗口上限内 -->
                    <ListBox ItemsSource="{Binding Rows}" MaxHeight="240"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Display}"
                                          ToolTip="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3" Margin="20,16,20,18">
                <!-- 勾选辅助：全选 / 全取消（贴左） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="{loc:Loc pkg.related.selectAll}" Padding="10,4" FontSize="12"
                            Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllCommand}"/>
                    <Button Content="{loc:Loc pkg.related.selectNone}" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Command="{Binding SelectNoneCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc common.cancel}" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                    <Button x:Name="DeleteButton" Margin="8,0,0,0"
                            Style="{StaticResource DangerFillButton}"
                            Content="{loc:Loc pkg.related.confirm}"
                            IsEnabled="{Binding HasSelection}" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
