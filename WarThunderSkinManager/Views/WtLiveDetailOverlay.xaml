<UserControl x:Class="WarThunderSkinManager.Views.WtLiveDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WarThunderSkinManager.Localization"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- WT Live 涂装详情浮窗（点浏览页卡片打开）：所有预览图轮播 + 完整信息 + 下载。
         可见性由 WtLive.Detail.IsOpen 驱动；遮罩盖住内容区，点空白处 / Esc 关闭 -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WtLive.Detail.IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <!-- 信息行：为空的那行自动收起（统计行可能整行缺项，不留空行） -->
        <Style x:Key="InfoLine" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 作者行：同款外观，但**不要"空了就收起"**那条 —— 收起判据读的是 TextBlock.Text，
             而这一行装的是 Hyperlink（Text 始终为空），套 InfoLine 会被误判成空行整行消失 -->
        <Style x:Key="AuthorLine" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <!-- 遮罩根：滚轮只挂在轮播格上（见下）——挂在这里会把正文文本框的滚动一起吃掉 -->
    <Grid>
        <!-- 压暗底：沿用主题背景色（与全局「处理中」遮罩同一套观感，四套主题自动一致），
             同时挡住底下页面的交互；点空白处 = 关窗。
             ⚠️ 关窗必须用 **MouseLeftButtonUp**：若在 Down 里关，浮窗当场 Collapsed，
             这次点击的 Up 就落到下面那张卡片上，顺带又打开了另一个详情 -->
        <Border Background="{StaticResource BrushBackground}" Opacity="0.72"
                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"
                MouseLeftButtonUp="Backdrop_MouseLeftButtonUp"/>

        <!-- 宽度**不跟内容走**：Stretch + MaxWidth 才是"铺满可用宽度、最多 820"。
             若用 Center，卡片宽度会退化成内容期望宽——低清缩略图只有 386px、文案又短时，
             浮窗就被压成一根细条（原图加载完又撑开，观感还会跳） -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MaxWidth="820" Margin="48,40"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                CornerRadius="12" Padding="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.26" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 轮播：占剩余高度；图片 Uniform 且只缩不放（低清垫底图不会被拉糊）。
                     **滚轮只在这一格里切图**——所以鼠标停在正文 / 信息区时，滚轮该滚文本就滚文本 -->
                <Grid Grid.Row="0" MinHeight="140" PreviewMouseWheel="Carousel_PreviewMouseWheel">
                    <Image Source="{Binding WtLive.Detail.Current.Image}"
                           Stretch="Uniform" StretchDirection="DownOnly"/>

                    <!-- 关窗：浮窗右上角（图标形式，同其它图标按钮一样必须给 ToolTip）。
                         垫一层浅色圆角底：图片深浅不定，纯图标会有一半场合看不清 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            Background="{StaticResource BrushSurface}" Opacity="0.92" CornerRadius="14">
                        <Button Content="&#xF00D;" Style="{StaticResource IconButton}"
                                Width="28" Height="28" FontSize="14"
                                ToolTip="{loc:Loc common.close}"
                                Command="{Binding WtLive.Detail.CloseCommand}"/>
                    </Border>

                    <!-- 这一张正在下载 / 解码：转圈 +（**转够 5s** 才浮现的）「重新加载」 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.Detail.Current.IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <ContentControl Style="{StaticResource BusySpinner}"/>
                        </Viewbox>

                        <Button Content="{loc:Loc wtlive.reload}"
                                Margin="0,10,0,0" HorizontalAlignment="Center"
                                MinWidth="84" Height="28" Padding="12,0" FontSize="12"
                                CommandParameter="{Binding WtLive.Detail.Current}"
                                Command="{Binding WtLive.Detail.ReloadImageCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding WtLive.Detail.Current.IsLoading}" Value="True"/>
                                                <Condition Binding="{Binding WtLive.Detail.Current.CanReload}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 没有图 / 这一张取不到：占位图标（不转圈，否则永远在"加载"） -->
                    <TextBlock Text="&#xF03E;" FontFamily="{StaticResource IconFont}"
                               FontSize="30" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding WtLive.Detail.IsLoading}" Value="False"/>
                                            <Condition Binding="{Binding WtLive.Detail.Current}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding WtLive.Detail.Current.IsFailed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 上一张 / 下一张（单张时不显示；鼠标滚轮同样可切） -->
                    <Button Content="&#xF053;" HorizontalAlignment="Left" VerticalAlignment="Center"
                            ToolTip="{loc:Loc wtlive.detail.prev}"
                            Command="{Binding WtLive.Detail.PreviousCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WtLive.Detail.HasMultipleImages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xF054;" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="{loc:Loc wtlive.detail.next}"
                            Command="{Binding WtLive.Detail.NextCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WtLive.Detail.HasMultipleImages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 计数 + 滚轮提示：多张时才有意义 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                            Background="{StaticResource BrushSurface}" Opacity="0.92"
                            CornerRadius="8" Padding="8,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WtLive.Detail.HasMultipleImages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc wtlive.detail.wheelHint}" FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding WtLive.Detail.IndexText}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 信息区：**两列** —— 左「作者头像（圆形）」，右「标题 / 作者（超链接）/ 一行统计」。
                     头像的宽高在 DetailInfo_SizeChanged 里跟着右列走（右列多高、圆就多大），
                     所以两边**占同一高度**、看起来是一整块；点头像或作者名都 = 按作者搜索 -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- 头像列：宽度由头像自己定（见 code-behind 的同步） -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AuthorAvatarBox" Grid.Column="0"
                            Width="64" Height="64" CornerRadius="999"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrushBackground}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="{loc:Loc wtlive.detail.searchAuthor}"
                            MouseLeftButtonUp="AuthorAvatar_MouseLeftButtonUp">
                        <Grid>
                            <!-- 头像原图（圆形靠 code-behind 挂的椭圆 Clip 裁，Border 的圆角裁不到子元素） -->
                            <Image Source="{Binding WtLive.Detail.AuthorAvatar}" Stretch="UniformToFill"/>

                            <!-- 没有头像 / 还没下好：占位图标（不下发"加载中"——头像不是内容主体） -->
                            <TextBlock Text="&#xF007;" FontFamily="{StaticResource IconFont}"
                                       FontSize="22" Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WtLive.Detail.AuthorAvatar}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 右列：上面那一叠（标题 / 作者 / 统计）就是 DetailInfo —— **头像跟它同高**；
                         错误行不在其中，免得"详情没读到"一出现就把头像也撑大 -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel x:Name="DetailInfo" SizeChanged="DetailInfo_SizeChanged">
                            <TextBlock Text="{Binding WtLive.Detail.Title}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource AuthorLine}">
                                <Hyperlink Command="{Binding WtLive.Detail.SearchAuthorCommand}"
                                           Foreground="{StaticResource BrushPrimary}"
                                           TextDecorations="Underline"
                                           ToolTip="{loc:Loc wtlive.detail.searchAuthor}">
                                    <Run Text="{Binding WtLive.Detail.Author, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding WtLive.Detail.StatsText}" Style="{StaticResource InfoLine}"/>
                        </StackPanel>

                        <!-- 读取失败：给出原因与重试（卡片那层信息仍在上面，不至于空窗） -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WtLive.Detail.HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding WtLive.Detail.ErrorMessage}" FontSize="12"
                                       Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"
                                       MaxWidth="520" VerticalAlignment="Center"/>
                            <Button Content="{loc:Loc wtlive.list.retry}" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" MinWidth="72"
                                    Command="{Binding WtLive.Detail.RetryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 正文：可选中复制（与「从 WT Live 下载」确认窗同一处理），限高滚动；空正文折叠该行。
                     高度：短正文 80、长正文最多 180（12 行左右），超出在框内滚动——
                     原图那格是 * 行，正文长多少图就让多少，两边都不挤 -->
                <TextBox Grid.Row="2" Margin="0,10,0,0" MaxHeight="180"
                         Height="Auto" MinHeight="80" Padding="6,5"
                         VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                         Text="{Binding WtLive.Detail.Description, Mode=OneWay}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 标签（写在正文下面）：站点把描述里的标签**服务端**包成了 ?q=%23xxx 的链接，
                     我们从那里认（认不出再用文本兜底，见 WtLiveTag）。
                     超链接样式与设置页「关于」一致；点一下 = **清掉现有条件**按该标签重新搜（见 SearchTag） -->
                <ItemsControl Grid.Row="3" Margin="0,10,0,0" ItemsSource="{Binding WtLive.Detail.Tags}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WtLive.Detail.HasTags}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,10,4" FontSize="12">
                                <Hyperlink CommandParameter="{Binding}"
                                           Command="{Binding DataContext.WtLive.SearchTagCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Foreground="{StaticResource BrushPrimary}"
                                           TextDecorations="Underline">
                                    <Run Text="{Binding ., Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 底部动作：在浏览器打开（左） / 下载 + 关闭（右） -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Button HorizontalAlignment="Left" Content="{loc:Loc wtlive.detail.openInBrowser}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding WtLive.Detail.PostUrl}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 下载 = 既有的「从 WT Live 下载」确认窗（链接已预填并自动读取）；
                             没有站内附件的帖子置灰（信息区已写明原因）。
                             关窗不在这一行：它挪到了浮窗右上角的图标按钮（Esc / 点空白处同样可关） -->
                        <Button Content="{loc:Loc wtlive.detail.download}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding WtLive.Detail.HasFile}"
                                Command="{Binding Skins.OpenWtLiveImportCommand}"
                                CommandParameter="{Binding WtLive.Detail.PostUrl}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
